// H-027 — VWAP BAND BREAKOUT. Signals only, no orders.
//
// Paste into TradingView: Pine Editor -> new indicator -> paste -> Add to chart.
//
// WHAT THIS IS. The exact entry rule the blind walk-forward trades, drawn on a
// chart so it can be eyeballed. It is an INDICATOR, not a strategy: it marks the
// bar the rule fires on and draws the level the stop would sit at. It places no
// orders and reports no profit, because a TradingView strategy tester would
// charge different costs, fill differently and re-select nothing - and any
// number it printed would then be compared against this project's numbers by
// somebody, which is exactly the comparison that is not valid.
//
// THE RULE, in full:
//   * VWAP is anchored to the UTC day and so is its volume-weighted sigma.
//   * z = (close - vwap) / sigma, measured on the CLOSED bar.
//   * long when z >= threshold, short when z <= -threshold.
//   * the fill is the NEXT bar's open. The marker is on the signal bar, so the
//     trade you would have is one bar to its right.
//   * stop = entry -/+ stop_sigma * sigma_at_the_signal_bar. There is no target;
//     removing it is the finding the hypothesis is built on.
//   * exit otherwise at the horizon, in bars.
//   * optional filters: a UTC session window, and a minimum relative volume on
//     the signal bar.
//
// WHAT WILL NOT MATCH THE BACKTEST, and why it is not a bug:
//   * TradingView's feed is a different data vendor with different volume. This
//     rule is volume-weighted, so the VWAP and sigma will differ slightly.
//   * The backtest refuses to trade a bar that never traded (Dukascopy pads the
//     closed FX weekend with zero-volume bars). TradingView does not show those
//     bars at all, which is the same thing by a different route.
//   * The backtest charges a measured spread plus commission both sides. Nothing
//     here is charged anything.
//
// Defaults below are the configuration the blind selector chose most often on
// {{MARKET}} — see the board. They are a starting point, not a recommendation.

//@version=5
indicator("H-027 VWAP band breakout — signals", shorttitle="H-027 break",
     overlay=true, max_lines_count=500, max_labels_count=500)

// ---- inputs ---------------------------------------------------------------
thr      = input.float({{THR}}, "Threshold z (enter beyond this many sigma)", minval=0.1, step=0.05, group="Rule")
stopSig  = input.float({{STOP_SIG}}, "Stop, in sigma", minval=0.1, step=0.05, group="Rule")
holdBars = input.int({{MAX_HOLD}}, "Horizon, in bars", minval=1, group="Rule")
hourLo   = input.int({{HOUR_LO}}, "Session window, UTC hour from", minval=0, maxval=23, group="Filters")
hourHi   = input.int({{HOUR_HI}}, "Session window, UTC hour to (equal = no window)", minval=0, maxval=23, group="Filters")
minRvol  = input.float({{MIN_RVOL}}, "Minimum relative volume on the signal bar (0 = off)", minval=0.0, step=0.1, group="Filters")
rvolLen  = input.int(480, "Relative-volume baseline, bars", minval=20, group="Filters")
showStop = input.bool(true, "Draw the stop level while a hypothetical trade is open", group="Display")
showBand = input.bool(true, "Draw the entry bands", group="Display")
showLabels = input.bool(true, "BUY / SELL labels on the signal bar", group="Display")
colorBars  = input.bool(true, "Colour the signal candle", group="Display")
showEntry  = input.bool(true, "Mark the entry bar (the next bar's open)", group="Display")
showRaw    = input.bool(false, "Show every bar the condition is true (NOT the trade count)", group="Display")
showExit   = input.bool(true, "Mark where the trade closes", group="Display")
showStats  = input.bool(true, "Count the trades on this chart (top right)", group="Display")

// ---- anchored VWAP and its volume-weighted sigma --------------------------
// UTC day index straight off the bar's epoch, so the anchor does not move with
// the chart's timezone the way session() would.
utcDay  = math.floor(time / 86400000)
newSess = na(utcDay[1]) or utcDay != utcDay[1]

var float pv  = 0.0
var float vv  = 0.0
var float p2v = 0.0
var float lastV = na

// A zero-volume bar is weighted by the last non-zero volume, matching
// strategies/vwap/sweep.py::vwap_series. On a venue that reports real volume
// this branch never fires.
vRaw = nz(volume, 0.0)
v = vRaw > 0 ? vRaw : nz(lastV, 1.0)
if vRaw > 0
    lastV := vRaw

tp = (high + low + close) / 3.0
if newSess
    pv  := 0.0
    vv  := 0.0
    p2v := 0.0
pv  := pv + tp * v
vv  := vv + v
p2v := p2v + tp * tp * v

vwap  = vv > 0 ? pv / vv : na
varr  = vv > 0 ? p2v / vv - vwap * vwap : na
sigma = math.sqrt(math.max(nz(varr), 0.0))
// the same guard the kernel uses: sigma is a difference of two near-equal
// accumulated sums, so anything under a millionth of price is float noise
sigOk = not na(vwap) and sigma > vwap * 1e-6
z     = sigOk ? (close - vwap) / sigma : na

// ---- filters --------------------------------------------------------------
hh     = hour(time, "UTC")
inSess = hourLo == hourHi ? true :
   hourLo < hourHi ? (hh >= hourLo and hh < hourHi) : (hh >= hourLo or hh < hourHi)

// baseline is SHIFTED by one bar: a bar is never judged on its own completed
// volume. Reading the signal bar's own volume is the mistake that inflated an
// earlier hypothesis' profit factor from 0.627 to 2.765.
rvolBase = ta.sma(vRaw, rvolLen)[1]
rvol     = rvolBase > 0 ? vRaw / rvolBase : 0.0
rvolOk   = minRvol <= 0.0 or rvol >= minRvol

longSig  = not na(z) and z >= thr and inSess and rvolOk
shortSig = not na(z) and z <= -thr and inSess and rvolOk

// ---- drawing --------------------------------------------------------------
pVwap = plot(vwap, "VWAP (UTC day anchor)", color=color.new(color.orange, 0), linewidth=2)
upper = sigOk ? vwap + thr * sigma : na
lower = sigOk ? vwap - thr * sigma : na
pUp = plot(showBand ? upper : na, "Upper band", color=color.new(color.teal, 30))
pDn = plot(showBand ? lower : na, "Lower band", color=color.new(color.teal, 30))
fill(pUp, pDn, color=color.new(color.teal, 94), title="Band")

// ---- the hypothetical trade, so the horizon and stop are visible ----------
// Entry is the NEXT bar's open, which is why nothing is drawn on the signal bar
// itself. One position at a time, exactly as the kernel runs it.
var int   posDir   = 0
var float posStop  = na
var int   posBars  = 0
var float posEntry = na
var float posRisk  = na

// ---- what this rule actually does on THIS chart ---------------------------
// KRIS, 2026-09-09: "are you sure it's 5 trades a day? May 8 to May 23 is
// basically zero." He was right, and the two numbers were measuring different
// things. The BOARD's 5.39 trades/day is the ten-configuration book - the
// selection rule that trades the ten best configs at once. THIS chart is ONE
// configuration, and one configuration takes 0.55 trades a day on gold 1h:
// one every 1.8 days, with a p90 gap of 70 bars and a longest gap of 428.
//
// The gap he saw is the rule working: it is IN a position 75% of all bars, and
// a winner that runs for a fortnight produces no new signals while it runs.
//
// So the counts belong on the chart rather than in a commit message. Every
// number in this table is computed from the bars in front of you.
var int   nTrades = 0
var int   nWins   = 0
var float sumR    = 0.0
var int   barsIn  = 0
var int   sumHold = 0

closedLong  = false
closedShort = false
if posDir != 0
    posBars := posBars + 1
    barsIn  := barsIn + 1
    hitStop = posDir == 1 ? low <= posStop : high >= posStop
    if hitStop or posBars >= holdBars
        // the kernel's fill assumptions: a stop the bar GAPPED past fills at the
        // open, not at the level, and a horizon exit fills at the close
        exitPx = hitStop ? ((posDir == 1 and open < posStop) or
           (posDir == -1 and open > posStop) ? open : posStop) : close
        rMult = posRisk > 0 ? (exitPx - posEntry) * posDir / posRisk : 0.0
        nTrades := nTrades + 1
        nWins   := nWins + (rMult > 0 ? 1 : 0)
        sumR    := sumR + rMult
        sumHold := sumHold + posBars
        closedLong  := posDir == 1
        closedShort := posDir == -1
        posDir  := 0
        posStop := na
        posBars := 0

if posDir == 0 and (longSig[1] or shortSig[1])
    side  = longSig[1] ? 1 : -1
    risk  = stopSig * nz(sigma[1])
    entryPx = open
    if risk > 0
        posDir   := side
        posEntry := entryPx
        posStop  := side == 1 ? entryPx - risk : entryPx + risk
        posBars  := 0
        posRisk  := risk

plot(showStop and posDir != 0 ? posStop : na, "Stop level", color=color.new(color.red, 20),
     style=plot.style_linebr, linewidth=1)
plot(showStop and posDir != 0 ? posEntry : na, "Entry", color=color.new(color.gray, 40),
     style=plot.style_linebr, linewidth=1)
bgcolor(posDir == 1 ? color.new(color.teal, 85) : posDir == -1 ? color.new(color.red, 85) : na,
     title="In a hypothetical position")

// ---- what actually gets traded -------------------------------------------
// KRIS, 2026-09-09, looking at the first version: "on every buy/sell we are
// buying and selling? maybe it's a bit too often". He was right to ask, and the
// chart was wrong, not the rule.
//
// The rule's CONDITION stays true for as long as price is beyond the band -
// often ten bars in a row. The kernel does not trade ten times: it opens one
// position and then jumps to that trade's exit bar before it looks for another
// signal. The first version of this indicator drew the condition, so a single
// trade appeared as a run of labels and the chart implied a trade rate roughly
// ten times what the backtest actually takes.
//
// A label now means A TRADE THE RULE WOULD OPEN: the condition is true AND
// nothing is open. Turn on "Show every bar the condition is true" to see the
// raw excursions again as faint dots - useful for understanding the rule,
// misleading as a trade count, which is why it is off by default.
tradeLong  = longSig and posDir == 0
tradeShort = shortSig and posDir == 0

plotshape(showLabels and tradeLong, title="BUY", style=shape.labelup,
     location=location.belowbar, color=color.new(color.teal, 0),
     textcolor=color.white, text="BUY", size=size.small)
plotshape(showLabels and tradeShort, title="SELL", style=shape.labeldown,
     location=location.abovebar, color=color.new(color.red, 0),
     textcolor=color.white, text="SELL", size=size.small)

barcolor(colorBars and tradeLong ? color.new(color.teal, 0) :
   colorBars and tradeShort ? color.new(color.red, 0) : na, title="Signal candle")

plotshape(showEntry and tradeLong[1], title="Entry bar, long", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.teal, 45), size=size.tiny)
plotshape(showEntry and tradeShort[1], title="Entry bar, short", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 45), size=size.tiny)

plotshape(showRaw and longSig and not tradeLong, title="Condition true, no trade",
     style=shape.circle, location=location.belowbar,
     color=color.new(color.teal, 70), size=size.tiny)
plotshape(showRaw and shortSig and not tradeShort, title="Condition true, no trade",
     style=shape.circle, location=location.abovebar,
     color=color.new(color.red, 70), size=size.tiny)

// ---- exit marks, so a quiet stretch explains itself ------------------------
plotshape(showExit and closedLong, title="Exit, long", style=shape.xcross,
     location=location.abovebar, color=color.new(color.teal, 20), size=size.tiny)
plotshape(showExit and closedShort, title="Exit, short", style=shape.xcross,
     location=location.belowbar, color=color.new(color.red, 20), size=size.tiny)

var table stats = table.new(position.top_right, 2, 7, border_width=1,
     frame_width=1, frame_color=color.new(color.gray, 60))
// The first bar's timestamp is carried forward rather than read back with
// `time[bar_index]`: a history reference that deep makes Pine guess a
// max_bars_back and it is the usual cause of "cannot determine referencing
// length" on a long chart.
var float firstTime = na
if na(firstTime)
    firstTime := time

if showStats and barstate.islast
    spanDays = math.max((time - firstTime) / 86400000.0, 1.0)
    bg = color.new(color.black, 20)
    table.cell(stats, 0, 0, "H-027 on this chart", text_color=color.white,
         bgcolor=color.new(color.blue, 40), text_size=size.small)
    table.cell(stats, 1, 0, "", bgcolor=color.new(color.blue, 40))
    table.cell(stats, 0, 1, "trades", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(stats, 1, 1, str.tostring(nTrades), text_color=color.white, bgcolor=bg, text_size=size.small)
    table.cell(stats, 0, 2, "per day", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(stats, 1, 2, str.tostring(nTrades * 1.0 / spanDays, "#.##"), text_color=color.white, bgcolor=bg, text_size=size.small)
    table.cell(stats, 0, 3, "win rate", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(stats, 1, 3, nTrades > 0 ? str.tostring(nWins * 100.0 / nTrades, "#.#") + "%" : "—",
         text_color=color.white, bgcolor=bg, text_size=size.small)
    table.cell(stats, 0, 4, "avg R", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(stats, 1, 4, nTrades > 0 ? str.tostring(sumR / nTrades * 1.0, "+#.###") : "—",
         text_color=sumR > 0 ? color.teal : color.red, bgcolor=bg, text_size=size.small)
    table.cell(stats, 0, 5, "avg hold, bars", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(stats, 1, 5, nTrades > 0 ? str.tostring(sumHold * 1.0 / nTrades, "#.#") : "—",
         text_color=color.white, bgcolor=bg, text_size=size.small)
    table.cell(stats, 0, 6, "bars in a position", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(stats, 1, 6, str.tostring(barsIn * 100.0 / (bar_index + 1), "#.#") + "%",
         text_color=color.white, bgcolor=bg, text_size=size.small)

alertcondition(tradeLong,  "H-027 long signal",  "H-027: close is {{THR}}+ sigma above the anchored VWAP")
alertcondition(tradeShort, "H-027 short signal", "H-027: close is {{THR}}+ sigma below the anchored VWAP")
