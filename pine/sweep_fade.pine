//@version=6
// =============================================================================
// H-005 · Liquidity sweep fade  —  board score 4.0/10  —  REJECTED
// prop_lab · https://github.com/KristijonasSim/prop_lab
//
// DO NOT TRADE THIS. It is here so the board is complete and so the rejection
// can be re-checked by hand, not because it is a candidate.
//
// WHY IT WAS REJECTED: 541,474 configurations across 12 markets and 5
// timeframes. The real data cleared PF 1.20 on 1,702 of them. The paired-shuffle
// null cleared it on 19,062 — ELEVEN TIMES MORE — and the null's best config
// (3.858) beat the real best (1.929). Only 2 of 57 market x timeframe pairs beat
// their own null. A sweep-and-revert rule is simply EASIER to satisfy on
// shuffled data, because a permuted series reverts around its extremes more
// readily than a real trending one. Anything that looks good here is that
// artefact, not an edge.
//
// Mechanism as originally stated: price takes out an N-bar extreme, trapping
// the stops resting beyond it, then closes back inside the range on the same
// bar. The counterparty is whoever just got filled at the worst price of the
// move. Fade it.
// =============================================================================
strategy("H-005 Liquidity sweep fade · prop_lab [REJECTED]", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, commission_type=strategy.commission.percent,
     commission_value=0.05, margin_long=100, margin_short=100, pyramiding=0)

lookback  = input.int(20,    "Range lookback (bars)",        minval=5)
pierceATR = input.float(0.1, "Pierce depth (ATR)",           minval=0.0, step=0.05)
needWick  = input.bool(true, "Require close back inside the range")
minRngATR = input.float(1.0, "Minimum range (ATR)",          minval=0.0, step=0.5)
stopK     = input.float(1.0, "Stop beyond the swept extreme (ATR)", minval=0.1, step=0.5)
rrIn      = input.float(0.0, "Target (R multiple, 0 = fade back to the far side)", minval=0.0, step=0.5)
atrLen    = input.int(14,    "ATR length",                   minval=2)

a  = ta.atr(atrLen)
hi = ta.highest(high[1], lookback)
lo = ta.lowest(low[1],   lookback)
rng = hi - lo
rangeOK = rng >= minRngATR * a

// swept the highs -> trapped longs above -> fade short, and the mirror
sweptHigh = high > hi + pierceATR * a and (not needWick or close < hi)
sweptLow  = low  < lo - pierceATR * a and (not needWick or close > lo)

canTrade = rangeOK and a > 0 and barstate.isconfirmed

if canTrade and sweptLow and strategy.position_size <= 0
    st = low - stopK * a
    strategy.entry("L", strategy.long)
    if rrIn > 0
        strategy.exit("L x", "L", stop=st, limit=close + rrIn * (close - st))
    else
        strategy.exit("L x", "L", stop=st, limit=hi)

if canTrade and sweptHigh and strategy.position_size >= 0
    st = high + stopK * a
    strategy.entry("S", strategy.short)
    if rrIn > 0
        strategy.exit("S x", "S", stop=st, limit=close - rrIn * (st - close))
    else
        strategy.exit("S x", "S", stop=st, limit=lo)

plot(hi, "Range high", color.new(color.gray, 30))
plot(lo, "Range low",  color.new(color.gray, 30))
plotshape(canTrade and sweptHigh, "Sweep high", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.tiny)
plotshape(canTrade and sweptLow,  "Sweep low",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.tiny)
