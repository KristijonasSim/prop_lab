// prop_lab: fetched from TradingView 2026-10-08
// url: https://www.tradingview.com/script/TlOcVraF-NY-VIX-Channel-Trend-US-Futures-Day-Trade-Strategy/
// id: PUB;cf5339409b5b4d44829b123cecb1f93a  kind: strategy  likes: 110
