    array.push(EDGE_PARTS, "K6HKcI0mp0tl0vh1im1ms1.r2Ki2dl2nk2wl35l3Ok3cm3eo3rp46k4Do4ji4xp5Yh5yp8YhEvmHgmHojHpqHxkI.sJSsJajKUqKVq0Go0bi1Ak1Bm3Ul4Qh4Rh5th8qh8yhA8hE9hI3hIskIuiJ8kJMhJclJgh04W0iW2XW2zWJpW04W0iW2XW2zWJoW01q2bi4eh4zh5ZhHYhIPj05m0JmIYjJJh17i2am4Jj4coHRnKbl0Gi0xl1Ai1Bh3Uk4kh5niC8hJ8qJMm1L9IiDIkIIl5J5BJPLJ_.jJShJajJmq07n0Bj0Uj1Bi2mk2xl9TiDkiGbhIXmIslKSi0Go0Ui0bj19i1Bh3Ul4Ri5Lh6Zj83i9JhA2iDehE9iI3iIslIuiJ8mJMiJcm02j0Sn3UkCah")
    array.push(EDGE_PARTS, "EPjHPhI2mIjlJMi0Gk0bh0xk19i1Aj3Uk6Xh8kj9ziCehD0hFoiHBhIuhJ8nJMj0LI1BH02j0Ll0bi0en1Bi2mi2xk3Sh48h4Fh9siAQhGqhH7hH.hIZhIihIkkJ5jJuhKZj1ri22i24j28h2Bh2qh3Om4Dh4xk6Ls9IjJli03W0BW0SW0wW7ZW03W0wW07n0Bl19i2ml2xlGyiIsl0Eq07n0Bi0Hi0Uh10i19h2xjIsm0yJ1JF1gG31K03W0wW7ZW02l0Sm0kh3UjI1jIjnJMkJQi02h0bh2mj6Hi6IjH.lIknJ5jJ8hKZh02j0ek1Bi2mj2xj8rhBahDuhH.kIZiIiiIknJ5hJuj07m0Ai0Bk0Kh0Ul0bi1Bk2ml2xm3_j6ih8Ah9ThB0hGghIXoIsjKBi0BL0FK0KH0.I1ZK0Nl1Mh1Oj1cl1fm1il1mn1ol1pl1yj1zj1.p23l2Hi2dm2qh35h3el49i4fh5Mh5Yi8YjC5mHQiHgrHijHomHpoIdjIeiI.kJSmJmnK6iKci08h0Nh0Zo0mp0vi1Gh1Oj1cn1dl1fi1kk1mj1oi1pl1yi1zl1.h23k2Ck2do3en3oh4Ik5Mi5Yl8YlC5nEvmHOjHQmHgiHnjHxiHzlIdiIeiIzjI._hFxhIsiJ8o")
    array.push(EDGE_PARTS, "JMkJgh07n0Bi2mm2xkHmkIsm07l0Bj0Hh0Qh19h2mm2xjHmiIsn")
loadPROJ0() =>
    array.push(PROJ_PARTS, ".RYUoYSYcVadphXJMVMWKalYSMmnNmlsZcpaRPTmlthZjgJcMcQedOVdKcTcUJiOecMEnSZLKJJMgcbXQVYUYQHeYhGRhZVOTdgdmWSNPZLmWGXXdbnTkbKfZFjeTHTRigUKQ9ccaSNpZSRRRZVYbU9WcMiZQaQSPSLSiXZYjJbcbTTcQajWUWTgoSJcfU5LbBYkfbHRjZdjXZKrUDdXVURiRYR8VdUgcZfQaFMXrnTfiYLVMkSKRTebSTfeeIDbTfILOWbHRlMNgQVaUZTYRoJWUMVMCSb")
    array.push(PROJ_PARTS, "KNdWEVgDRFfCZqhOXeWgedikbceUSeaQTJebQeWUPIXIghbQYgXUWWfbYeTVTWedJVImVUPSZWHaGSIYDRDUjn_")
    array.push(PROJ_PARTS, "")
    array.push(PROJ_PARTS, "")
    array.push(PROJ_PARTS, "")
    array.push(PROJ_PARTS, "")
    array.push(PROJ_PARTS, "TMdigfOYVFSOecVORLMUQJbOGlDTDPfQeSLINaikRTcHTGhIDgZPnMefUXRNPWgKOSPGXyOecOVPXhdOcYRX_MLMRWgkYEYTOdSMqPWKicQLjWgbQKUlcDPiFRRNabeWYNncWhYoSUTZONNYjjtJVKgJIRRTXhKRSZaboYYXfNIhDSjGdRiZPLVXMrSZVlYcPbJsJOLKUUVaZVZKYdiOeFJeFXbJSSnO_.LgYLYMcONUuQMTTKTeC6MgP4ZTcTsNORBrYjfRRWf8OaYgVIZcTnPVUYgXcKVbScadJHiNXYcUFYbZgkeLbNdSBdRYSKVhQBjSHXsHSVWikoHRhMbbS9UZSeOTVdfRTQiTOfRMQbUgVaXVXccdIcOTacQLWJWbU.aKYRZmhPQN")
if barstate.isfirst
    loadEDGE0()
    loadEDGE1()
    loadEDGE2()
    loadEDGE3()
    loadEDGE4()
    loadEDGE5()
    loadEDGE6()
    loadPROJ0()
//__END_DATA__
// groups: 0 GF · 1 DNp09 · 2 MDN · 3 DNa · 4 DNg11 · 5 looming · 6 KC · 7 MBON · 8 PAM · 9 PPL1 · A APL/DPM

// ── Helpers ──────────────────────────────────────────────────────────────────
dec1(string s, int i) => nz(str.pos(ALPHA, str.substring(s, i, i + 1)), 0)
dec2(string s, int i) => dec1(s, i) * 64 + dec1(s, i + 1)
tanh(float x) =>
    xx = math.max(-20.0, math.min(20.0, x))
    e2 = math.exp(2.0 * xx)
    (e2 - 1.0) / (e2 + 1.0)
var int[] rngA = array.new_int(1, 42)
nextRnd() =>
    s = (array.get(rngA, 0) * 48271) % 2147483647
    array.set(rngA, 0, s)
    s
rndInt(int m) => nextRnd() % m

// ── Network state ────────────────────────────────────────────────────────────
var int[]   grp     = array.new_int(N_NEUR, 0)
var int[]   deg     = array.new_int(N_NEUR, 0)
var int[]   dstA    = array.new_int(0)
var float[] wA      = array.new_float(0)          // current: sign × contacts / wScale
var float[] wRaw    = array.new_float(0)          // |contacts| for the mushroom body
var float[] mA      = array.new_float(0)          // plastic multiplier (KC→MBON only)
var int[]   off     = array.new_int(N_NEUR + 1, 0)
var float[] v       = array.new_float(N_NEUR, 0.0)
var int[]   lastT   = array.new_int(N_NEUR, 0)
var int[]   firedAt = array.new_int(N_NEUR, -9)
var int[]   cur     = array.new_int(0)
var int[]   nxt     = array.new_int(0)
var int[]   loomIdx = array.new_int(0)
var float[] loomG   = array.new_float(0)
var int[]   gfIdx   = array.new_int(0)
var int[]   kcIdx   = array.new_int(0)            // global indices of KCs (projection order)
var int[]   mbonOf  = array.new_int(N_NEUR, -1)   // global → local MBON index
var float[] valence = array.new_float(N_MBON, 0.0)
var float[] dPam    = array.new_float(N_MBON, 0.0)
var float[] dPpl    = array.new_float(N_MBON, 0.0)
var float[] normM   = array.new_float(N_MBON, 1e-9)
var float[] projP   = array.new_float(N_KC * 10, 0.0)
var int[]   kmEdges = array.new_int(0)            // all KC→MBON edges (recovery)
var int[]   actEdges = array.new_int(0)           // KC→MBON edges of KCs active on the previous bar
var float[] kcDrive = array.new_float(N_KC, 0.0)
var int[]   epgIdx   = array.new_int(0)            // кольцо компаса: клетки и их углы,
var float[] epgAng   = array.new_float(0)          // восстановленные из связности
var int[]   fc2Idx   = array.new_int(0)            // цель
var float[] fc2Ang   = array.new_float(0)
var int[]   fwdInIdx = array.new_int(0)            // LC9 → DNp09
var int[]   revInIdx = array.new_int(0)            // входы MDN
var int[]   grmInIdx = array.new_int(0)            // входы DNg11
var int[]   pamIdx   = array.new_int(0)
var int[]   pplIdx   = array.new_int(0)
var int[]   backIdx  = array.new_int(0)            // MDN: читаем давление, не спайки
var int[]   groomIdx = array.new_int(0)            // DNg11: то же
var int[]   kcActive = array.new_int(0)            // код этого бара
var float[] turnSign = array.new_float(0)
var float[] epgCos   = array.new_float(0)          // cos/sin угла клетки кольца,
var float[] epgSin   = array.new_float(0)          // разложены по индексу нейрона
var float[] epgCur   = array.new_float(0)          // ток на кольцо: считается раз в бар
var float[] fc2Cur   = array.new_float(0)          // ток цели: постоянен, считается один раз          // +1 левым DNa02, −1 правым, 0 остальным
var int[]   grpSpk  = array.new_int(18, 0)        // spikes per group this bar (brain window)
var int[]   grpSize = array.new_int(18, 0)
var float[] mbonAct = array.new_float(N_MBON, 0.0)
var int phase = 1
var int builtEdges = 0
var int E = 0
var int gstep = 0
var int cooldown = 0
var int barsReady = 0
var int parseSrc = 0
var int parseLeft = 0
var int escTotal = 0
varip int tick = 0      // ticks inside the live bar (animation)
varip int vseed = 12345
if barstate.isnew
    tick := 0
tick += 1
var int gf3Total = 0

// ── Phase 1: build the graph (spread over bars) ──────────────────────────────
if phase == 1
    if builtEdges == 0
        i = 0
        kcK = 0
        mbK = 0
        while i < N_NEUR
            g = dec1(GROUPS, i)
            array.set(grp, i, g)
            array.set(grpSize, g, array.get(grpSize, g) + 1)
            array.set(deg, i, dec2(DEGREES, i * 2))
            if g == 0
                array.push(gfIdx, i)
            if g == 5
                array.push(loomIdx, i)
                array.push(loomG, 0.5 + dec1(LOOM_GAIN, array.size(loomIdx) - 1) / 63.0)
            if g == 6
                array.push(kcIdx, i)
                kcK += 1
            if g == 11
                array.push(fwdInIdx, i)
            if g == 13
                array.push(fc2Idx, i)
                array.push(fc2Ang, dec1(FC2_ANG, array.size(fc2Idx) - 1) * 2.0 * math.pi / 64.0)
            if g == 16
                array.push(revInIdx, i)
            if g == 17
                array.push(grmInIdx, i)
            if g == 8
                array.push(pamIdx, i)
            if g == 9
                array.push(pplIdx, i)
            if g == 2
                array.push(backIdx, i)
            if g == 4
                array.push(groomIdx, i)
            if g == 7
                array.set(mbonOf, i, mbK)
                array.set(valence, mbK, str.substring(VALENCE, mbK, mbK + 1) == "+" ? 1.0 : str.substring(VALENCE, mbK, mbK + 1) == "-" ? -1.0 : 0.0)
                array.set(dPam, mbK, dec1(DAN_PAM, mbK) / 63.0)
                array.set(dPpl, mbK, dec1(DAN_PPL, mbK) / 63.0)
                mbK += 1
            i += 1
        // кольцо компаса: его клетки — подмножество cx_heading, поэтому идут списком,
        // а углы приезжают готовыми: они восстановлены из связности, не назначены
        i := 0
        while i < N_NEUR
            array.push(epgCos, 0.0)
            array.push(epgSin, 0.0)
            i += 1
        ke = 0
        while ke * 2 < str.length(EPG_IDX)
            nId = dec2(EPG_IDX, ke * 2)
            th = dec1(EPG_ANG, ke) * 2.0 * math.pi / 64.0
            array.push(epgIdx, nId)
            array.push(epgAng, th)
            array.set(epgCos, nId, math.cos(th))
            array.set(epgSin, nId, math.sin(th))
            ke += 1
        // стороны тела четырёх клеток DNa02: поворот читается разностью полушарий
        array.clear(turnSign)
        i := 0
        while i < N_NEUR
            array.push(turnSign, 0.0)
            i += 1
        i := 0
        tk = 0
        while i < N_NEUR
            if array.get(grp, i) == 3
                array.set(turnSign, i, str.substring(TURN_SIDE, tk, tk + 1) == "L" ? 1.0 : -1.0)
                tk += 1
            i += 1
        j = 0
        while j < N_KC * 10
            part = math.floor(j / 1000)
            inner = j % 1000
            array.set(projP, j, dec1(array.get(PROJ_PARTS, part), inner) / 63.0 * 6.3 - 3.15)
            j += 1
        parseSrc := 0
        parseLeft := dec2(DEGREES, 0)
    blobE = (array.size(EDGE_PARTS) - 1) * EDGE_PART_EDGES + math.floor(str.length(array.get(EDGE_PARTS, array.size(EDGE_PARTS) - 1)) / 3)
    e = builtEdges
    stop = math.min(builtEdges + chunkIn, blobE)
    while e < stop
        while parseLeft == 0 and parseSrc < N_NEUR - 1
            parseSrc += 1
            parseLeft := dec2(DEGREES, parseSrc * 2)
        part = math.floor(e / EDGE_PART_EDGES)
        inner = (e % EDGE_PART_EDGES) * 3
        tok = str.substring(array.get(EDGE_PARTS, part), inner, inner + 3)
        d = dec2(tok, 0)
        // вес закодирован логарифмически: сохраняет и слабые связи, и сильные
        qw = dec1(tok, 2) - 32
        w = qw >= 0 ? math.exp(qw * W_STEP) - 1.0 : -(math.exp(-qw * W_STEP) - 1.0)
        array.push(dstA, d)
        array.push(wA, w / wScale)
        array.push(wRaw, math.abs(w))
        array.push(mA, 1.0)
        parseLeft -= 1
        e += 1
    builtEdges := e
    if builtEdges >= blobE
        phase := 2
if phase == 2
    i = 0
    acc = 0
    while i < N_NEUR
        array.set(off, i, acc)
        acc += array.get(deg, i)
        i += 1
    array.set(off, N_NEUR, acc)
    E := acc
    k = 0
    while k < array.size(kcIdx)
        n = array.get(kcIdx, k)
        ee = array.get(off, n)
        eEnd = array.get(off, n + 1)
        while ee < eEnd
            d = array.get(dstA, ee)
            if array.get(grp, d) == 7
                array.push(kmEdges, ee)
                mj = array.get(mbonOf, d)
                array.set(normM, mj, array.get(normM, mj) + array.get(wRaw, ee))
            ee += 1
        k += 1
    phase := 3

// ── Neuron (leaky integrate-and-fire, event-driven) ──────────────────────────
touch(int i, int t) =>
    dt = t - array.get(lastT, i)
    if dt > 0
        array.set(v, i, array.get(v, i) * math.pow(decayIn, dt))
        array.set(lastT, i, t)
inject(int i, float amt, int t) =>
    touch(i, t)
    fired = false
    fa = array.get(firedAt, i)
    if fa != t
        nv = array.get(v, i) + amt
        if nv >= thIn and fa < t - 1
            array.set(v, i, 0.0)
            array.set(firedAt, i, t)
            array.push(nxt, i)
            fired := true
        else
            array.set(v, i, nv)
    fired

// ── Market quantities ────────────────────────────────────────────────────────
retBar = close / nz(close[1], close) - 1.0
vol72  = nz(ta.stdev(retBar, 72), 0.0) + 1e-6
rngRel = (high - low) / nz(close[1], close)
retK(int k) => nz(close / close[k] - 1.0, 0.0)
// intrabar sensory preview: the eyes react to the bar as it forms; trading decisions still happen on bar close
liveMove = nz(close / open - 1.0, 0.0)
liveRange = nz((high - low) / nz(close[1], close), 0.0)
liveStim = (downIn * math.max(0.0, -liveMove) + upIn * math.max(0.0, liveMove) + rngIn * math.max(0.0, liveRange)) * gainIn

// Нормировка импульса на его же разброс, накопительно с первого бара.
// `ta.stdev(x, 500)` не определён первые 500 баров, а окно расчёта — 1200:
// на 42 % прогона знаменатель схлопывался, курс принимал всего четыре значения
// вместо непрерывного, и компас почти не двигался. Своё состояние на вызов.
runScale(float x) =>
    var float cnt = 0.0
    var float mu = 0.0
    var float s2 = 0.0
    cnt += 1.0
    d = x - mu
    mu += d / cnt
    s2 += d * (x - mu)
    sd = cnt > 2.0 ? math.sqrt(s2 / (cnt - 1.0)) : 0.0
    sd > 1e-9 ? x / sd : 0.0

// В Pine нет math.atan2, а курс — это именно угол в плоскости двух импульсов.
atan2(float y, float x) =>
    r = x > 0 ? math.atan(y / x) : x < 0 ? (y >= 0 ? math.atan(y / x) + math.pi : math.atan(y / x) - math.pi) : (y > 0 ? math.pi / 2 : y < 0 ? -math.pi / 2 : 0.0)
    r
// Свернуть угол в [−π, π].
wrapPi(float a) =>
    w = a - 2.0 * math.pi * math.floor((a + math.pi) / (2.0 * math.pi))
    w

// ── Market phase: the direction the fly is asked to hold ─────────────────────
// Heading is an angle, not a number: the market walks a cycle — up, topping, down,
// bottoming — and a ring attractor is the structure built for exactly that.
lr      = math.log(close / nz(close[1], close))
fastMom = nz(math.log(close / close[fastK]), 0.0)
slowMom = nz(math.log(close / close[slowK]), 0.0)
zFast   = math.max(-4.0, math.min(4.0, runScale(fastMom)))
zSlow   = math.max(-4.0, math.min(4.0, runScale(slowMom)))
heading = atan2(zFast, zSlow)
goalRad = goalDeg * math.pi / 180.0

// Накопительные среднее и разброс по всей истории нейрона (алгоритм Уэлфорда).
// Скользящее окно здесь не годится: давление на растормаживаемую команду —
// медленная величина, и порог должен сравниваться со всем, что нейрон видел,
// а не с последними четырьмя сотнями баров. Своё состояние на каждую точку вызова.
runZ(float x) =>
    var float cnt = 0.0
    var float mu = 0.0
    var float s2 = 0.0
    cnt += 1.0
    d = x - mu
    mu += d / cnt
    s2 += d * (x - mu)
    sd = cnt > 1.0 ? math.sqrt(s2 / (cnt - 1.0)) : 0.0
    sd > 1e-9 ? (x - mu) / sd : 0.0

// Давление на растормаживаемые команды держим между барами: на живом баре блок
// решения не выполняется, и обнуление засоряло бы скользящие среднее и разброс.
var int cEsc = 0
var int cGroom = 0
var int cTurn = 0
var int cBack = 0
var int cFwd = 0
var int cHold = 0
var int cWarm = 0
var int cTurnNZ = 0
var int cTurnUp = 0
var int cEntries = 0
var int cGfSpk = 0
var int cLoomSpk = 0
var float maxBackZ = -99.0
var float maxGroomZ = -99.0
var float bumpErr = 0.0
var bool bumpOk = false
var float backV = 0.0
var float groomV = 0.0
var float backZ = 0.0
var float groomZ = 0.0
var bool relReady = false

// ── Bar step ─────────────────────────────────────────────────────────────────
useReflex = modeIn != "buy&hold"
useWhole  = modeIn == "whole brain"
gfSpikes  = 0
fwdSpikes = 0
spkTotal  = 0
bumpX     = 0.0
bumpY     = 0.0
turnLR    = 0.0

pamNow    = 0.0
pplNow    = 0.0
posPrev   = strategy.position_size > 0 ? 1.0 : 0.0
if phase == 3 and barstate.isconfirmed
    barsReady += 1
    // Пауза после побега тикает в начале бара, до проверки гигантского волокна:
    // тогда «24 бара вне рынка» означает ровно 24 бара. Без этой строки счётчик
    // выставлялся и не убывал — муха, сорвавшись один раз на 357-м баре, уже не
    // возвращалась в рынок, и 834 бара из 1191 уходили в паузу.
    cooldown := math.max(0, cooldown - 1)
    // 1) dopamine for the previous decision: what the position actually earned this bar
    eqRet = nz(strategy.equity / nz(strategy.equity[1], strategy.equity) - 1.0, 0.0)
    rw = math.max(-3.0, math.min(3.0, eqRet / vol72))
    pamNow := math.max(0.0, rw)
    pplNow := math.max(0.0, -rw)
    if useWhole and array.size(actEdges) > 0
        q = 0
        na_ = array.size(actEdges)
        while q < na_
            ee = array.get(actEdges, q)
            mj = array.get(mbonOf, array.get(dstA, ee))
            dd = pamNow * array.get(dPam, mj) + pplNow * array.get(dPpl, mj)
            array.set(mA, ee, math.max(0.1, math.min(1.0, array.get(mA, ee) - etaIn * dd)))
            q += 1
        q := 0
        nk = array.size(kmEdges)
        while q < nk
            ee = array.get(kmEdges, q)
            array.set(mA, ee, array.get(mA, ee) + gammaIn * (1.0 - array.get(mA, ee)))
            q += 1
    // 2) the sparse memory code for this bar: which Kenyon cells the market lights up
    array.clear(actEdges)
    if useWhole
        f0 = tanh(retK(1) / vol72 / 3.0)
        f1 = tanh(retK(fastK) / vol72 / 3.0)
        f2 = tanh(retK(12) / vol72 / 3.0)
        f3 = tanh(retK(slowK) / vol72 / 3.0)
        f4 = tanh(retK(72) / vol72 / 3.0)
        f5 = tanh(rngRel / vol72 / 3.0)
        f6 = posPrev
        f7 = 0.0
        f8 = 1.0
        f9 = tanh(retBar / vol72 / 3.0)
        k = 0
        while k < N_KC
            base = k * 10
            d = f0 * array.get(projP, base) + f1 * array.get(projP, base + 1) + f2 * array.get(projP, base + 2) + f3 * array.get(projP, base + 3) + f4 * array.get(projP, base + 4) + f5 * array.get(projP, base + 5) + f6 * array.get(projP, base + 6) + f7 * array.get(projP, base + 7) + f8 * array.get(projP, base + 8) + f9 * array.get(projP, base + 9)
            array.set(kcDrive, k, d)
            k += 1
        // top KC_ACTIVE by drive. The absolute number matters, not the fraction:
        // a downstream neuron counts the spikes that arrive, not the share of the
        // population that sent them. Distilling the population and keeping the same
        // 5% sparsity was what cost the memory most of its fidelity.
        // Порог вместо сортировки: дешевле на каждом баре и ближе к тому, как
        // разреженность задаётся у животного — глобальным торможением APL, а не
        // упорядочиванием. z подобран так, чтобы отсекать примерно KC_ACTIVE клеток.
        mu = 0.0
        k := 0
        while k < N_KC
            mu += array.get(kcDrive, k)
            k += 1
        mu := mu / N_KC
        sd = 0.0
        k := 0
        while k < N_KC
            d2 = array.get(kcDrive, k) - mu
            sd += d2 * d2
            k += 1
        sd := math.sqrt(sd / N_KC) + 1e-9
        thr = mu + kcZ * sd
        array.clear(kcActive)
        k := 0
        while k < N_KC
            if array.get(kcDrive, k) >= thr
                array.push(kcActive, array.get(kcIdx, k))
            k += 1
    // 3) run the network
    array.fill(grpSpk, 0)
    stim = (downIn * math.max(0.0, -retBar) + upIn * math.max(0.0, retBar) + rngIn * math.max(0.0, rngRel)) * gainIn
    fwdDrive = math.max(0.0, math.min(zFast, zSlow)) * fwdGain
    revDrive = math.max(0.0, -zFast) * math.max(0.0, tanh(zSlow)) * revGain
    grmDrive = math.max(0.0, 1.0 - (math.abs(zFast) + math.abs(zSlow)) / 2.0) * grmGain
    // Профиль бугра внутри бара не меняется, а профиль цели не меняется вовсе.
    // Считать их на каждом из 12 шагов — это лишние сотни экспонент и косинусов.
    if useWhole
        if array.size(epgCur) == 0
            i = 0
            while i < array.size(epgIdx)
                array.push(epgCur, 0.0)
                i += 1
            i := 0
            while i < array.size(fc2Idx)
                array.push(fc2Cur, goalGain * math.exp(math.cos(array.get(fc2Ang, i) - goalRad) - 1.0))
                i += 1
        i = 0
        while i < array.size(epgIdx)
            array.set(epgCur, i, hdGain * math.exp(hdKappa * (math.cos(array.get(epgAng, i) - heading) - 1.0)))
            i += 1
    s = 0
    while s < stepsIn
        gstep += 1
        t = gstep
        array.clear(nxt)
        if stim > 0
            i = 0
            nl = array.size(loomIdx)
            while i < nl
                inject(array.get(loomIdx, i), stim * array.get(loomG, i), t)
                i += 1
        if useWhole
            // the compass: a bump of current on the ring, centred on the market's heading
            i = 0
            ne = array.size(epgIdx)
            while i < ne
                inject(array.get(epgIdx, i), array.get(epgCur, i), t)
                i += 1
            i := 0
            nf = array.size(fc2Idx)
            while i < nf
                inject(array.get(fc2Idx, i), array.get(fc2Cur, i), t)
                i += 1
            if fwdDrive > 0
                i := 0
                while i < array.size(fwdInIdx)
                    inject(array.get(fwdInIdx, i), fwdDrive, t)
                    i += 1
            if revDrive > 0
                i := 0
                while i < array.size(revInIdx)
                    inject(array.get(revInIdx, i), revDrive, t)
                    i += 1
            if grmDrive > 0
                i := 0
                while i < array.size(grmInIdx)
                    inject(array.get(grmInIdx, i), grmDrive, t)
                    i += 1
            i := 0
            while i < array.size(kcActive)
                inject(array.get(kcActive, i), kcGain, t)
                i += 1
            if pamNow > 0
                i := 0
                while i < array.size(pamIdx)
                    inject(array.get(pamIdx, i), danGain * pamNow, t)
                    i += 1
            if pplNow > 0
                i := 0
                while i < array.size(pplIdx)
                    inject(array.get(pplIdx, i), danGain * pplNow, t)
                    i += 1
        k = 0
        while k < noiseN
            inject(rndInt(N_NEUR), noiseA, t)
            k += 1
        c = 0
        nc = array.size(cur)
        while c < nc
            srcN = array.get(cur, c)
            ee = array.get(off, srcN)
            eEnd = array.get(off, srcN + 1)
            while ee < eEnd
                inject(array.get(dstA, ee), array.get(wA, ee) * array.get(mA, ee), t)
                ee += 1
            c += 1
        array.clear(cur)
        q = 0
        nn = array.size(nxt)
        while q < nn
            id = array.get(nxt, q)
            array.push(cur, id)
            gq = array.get(grp, id)
            array.set(grpSpk, gq, array.get(grpSpk, gq) + 1)
            if gq == 0
                gfSpikes += 1
            if gq == 1
                fwdSpikes += 1
            if gq == 3
                turnLR += array.get(turnSign, id)
            if gq == 12
                bumpX += array.get(epgCos, id)
                bumpY += array.get(epgSin, id)
            spkTotal += 1
            q += 1
        s += 1
    // which KC→MBON synapses were active this bar — those are the ones dopamine touches
    if useWhole
        i = 0
        while i < array.size(kcActive)
            nId = array.get(kcActive, i)
            ee = array.get(off, nId)
            eEnd = array.get(off, nId + 1)
            while ee < eEnd
                if array.get(grp, array.get(dstA, ee)) == 7
                    array.push(actEdges, ee)
                ee += 1
            i += 1
    // 4) read the commands, each the way its own circuit signals
    // Потенциал декеится лениво — только при инжекте. Чтобы прочесть давление,
    // нейрон надо сначала «догнать» до текущего шага, иначе в v лежит значение
    // с того момента, когда в него последний раз что-то приходило.
    backV := 0.0
    i = 0
    while i < array.size(backIdx)
        touch(array.get(backIdx, i), gstep)
        backV += array.get(v, array.get(backIdx, i))
        i += 1
    backV := backV / math.max(1, array.size(backIdx))
    groomV := 0.0
    i := 0
    while i < array.size(groomIdx)
        touch(array.get(groomIdx, i), gstep)
        groomV += array.get(v, array.get(groomIdx, i))
        i += 1
    groomV := groomV / math.max(1, array.size(groomIdx))
    // статистику давления копим на каждом баре, включая паузу после побега:
    // иначе порог сравнивался бы с усечённой историей
    backZ := runZ(backV)
    groomZ := runZ(groomV)
    // Ошибка курса читается с популяции кольца, а не со спайков четырёх клеток
    // DNa02: на кольце 600 спайков за бар, и такой сигнал переживает дистилляцию,
    // а разность спайков четырёх выходных клеток — нет. DNa02 остаётся в панели
    // как докладчик команды.
    bumpOk := bumpX * bumpX + bumpY * bumpY > 0.0
    if bumpOk
        bumpErr := wrapPi(atan2(bumpY, bumpX) - goalRad)
    relReady := barsReady > warmIn
    cGfSpk += gfSpikes
    cLoomSpk += array.get(grpSpk, 5)
    maxBackZ := math.max(maxBackZ, backZ)
    maxGroomZ := math.max(maxGroomZ, groomZ)
    if math.abs(turnLR) >= 1.0
        cTurnNZ += 1
        if turnLR > 0
            cTurnUp += 1
    if gfSpikes >= gfMinIn
        gf3Total += 1
        if cooldown == 0
            escTotal += 1
        cooldown := cdIn


// ── Decision: five commands, in the animal's own order of precedence ──────────
var float wantPos = 0.0
var string saidBy = "hold"
if phase == 3 and barstate.isconfirmed
    if modeIn == "buy&hold"
        wantPos := 1.0
        saidBy := "buy&hold"
    else if cooldown > 0
        wantPos := 0.0
        saidBy := "escape"
        cEsc += 1
    else if not useWhole
        wantPos := 1.0
        saidBy := "reflex"
    else if not relReady
        wantPos := fwdSpikes >= 1 ? 1.0 : wantPos
        saidBy := "warmup"
        cWarm += 1
    else if bumpOk
        wantPos := math.abs(bumpErr) < steerTol * math.pi / 180.0 ? 1.0 : 0.0
        saidBy := "turn"
        cTurn += 1
    else if backZ >= relZ
        wantPos := 0.0
        saidBy := "backward"
        cBack += 1
    else if fwdSpikes >= 1
        wantPos := 1.0
        saidBy := "forward"
        cFwd += 1
    else if groomZ >= relZ
        // грумминг — последний по старшинству: у животного это занятие «когда
        // больше нечем», оно подавляется другими действиями, а не подавляет их
        saidBy := "groom"
        cGroom += 1
    else
        saidBy := "hold"
        cHold += 1
    if wantPos > 0 and strategy.position_size == 0
        cEntries += 1
        strategy.entry("L", strategy.long, comment = "in")
    if wantPos == 0 and strategy.position_size > 0
        strategy.close("L", comment = saidBy)

// ── Panel plots ──────────────────────────────────────────────────────────────
plot(math.min(4.0, gfSpikes / gfMinIn), "DNp01 (Giant Fiber) spikes, in threshold units", color.new(color.red, 0), style = plot.style_columns)
hline(1, "escape threshold", color.new(color.red, 60), hline.style_dotted)
plot(turnLR, "DNa02 steering, left minus right", color.new(color.aqua, 0), linewidth = 2)
plot(backZ, "MDN release (z)", color.new(color.fuchsia, 40))
plot(groomZ, "DNg11 release (z)", color.new(color.olive, 40))
plot(pamNow, "dopamine PAM (reward)", color.new(color.green, 30), style = plot.style_histogram)
plot(-pplNow, "dopamine PPL1 (punishment)", color.new(color.orange, 30), style = plot.style_histogram)
plot(cEntries, "entries so far", display = display.data_window)


// Временный канал диагностики: текст ошибки выполнения читается из тултипа
// легенды, в отличие от значений графиков. Снять перед публикацией.

bgcolor(phase < 3 ? color.new(color.gray, 85) : cooldown > 0 ? color.new(color.red, 80) : strategy.position_size > 0 ? color.new(color.green, 92) : na)

// ── FlyTV avatar: one fly, see-through head; the circuits that fire light up in brain and body ──
// Two RLE pixel layers generated by tools/design/gen_avatar.py: AV_STATIC (body art) and AV_DYN (live circuits).
// A pulse travels head → neck → wings so activity reads as a wave, not noise.
//__AVATAR__
AV_W = 88
AV_H = 84
AV_STATIC = array.from("0U62e271610G6171e2620U", "0S62e26272620C627262e2620S", "0R61e2620261736C73610262e2610R", "0S620463724A726304620S", "0V634472487244630V", "0T62475172514451725147620T", "0R62435O43620R", "0N6442537A547A5342640N", "0K68517U51680K", "0J64b5637Q63b5640J", "0I63b96279867962b9630I", "0H63b7a3b162758298827562b1a3b7630H", "0G63b7a5b16272829C827262b1a5b7630G", "0G62b8a5b272819G8172b2a5b8620G", "0F62b9a5b172819I8172b1a5b9620F", "0F62bAa3b271819K8171b2a3bA620F", "0E63bE71829K8271bE630E", "0E62bF71819M8171bF620E", "0E62bE72819M8172bE620E", "0E62bE71829M8271bE620E", "0E62bE71829M8271bE620E", "0E62bE72819M8172bE620E", "0E63bD72819M8172bD630E", "0F62b4e1b971819M8171b9e1b4620F", "0F62b3e3b872819K8172b8e3b3620F", "0G62b2e3b971829I8271b9e3b2620G", "0G63bD6171829G827161bD630G", "0H63bB625171829E82715162bB630H", "0I63b9624372829A82724362b9630I", "0J64b56247728A724762b5640J", "0L674B7A4B670L", "0N624c620N", "0P624Y620P", "0R614W610R", "0S624S620S", "0U634M630U", "0X634G630X", "0a624C620a", "0Z61e1614C61e1610Z", "0Z62e25Ae2620Z", "0W61016154e158e1546101610W", "0V61e161527G5261e1610V", "0V6151e27Ie251610V", "0S6101615371e17Ge171536101610S", "0R61e161547K5461e1610R", "0S61e2537K53e2610S", "0S614151e1527K52e15141610S", "0S6141557I5541610S", "0S6141587454745841610S", "0S61425Q42610S", "0S61435O43610S", "0S61445M44610S", "0T61445K44610T", "0T614755445547610T", "0U614952445249610U", "0V61455E45610V", "0U61c2d141527652765241d1c2610U", "0T61c2d1c1d12Id1c1d1c2610T", "0S61c2d1c1d12Kd1c1d1c2610S", "0R61c2d1c1d1517K51d1c1d1c2610R", "0Q61c2d1c1d12Od1c1d1c2610Q", "0Q61c1d1c2d11Od1c2d1c1610Q", "0O62c2d1c1d1527M52d1c1d1c2620O", "0N61c3d1c1d1c12Qc1d1c1d1c3610N", "0M61c3d1c1d1c22Qc2d1c1d1c3610M", "0M61c2d1c2d1c141537K5341c1d1c2d1c2610M", "0L61c2d1c2d1c1d12Sd1c1d1c2d1c2610L", "0K61c3d1c1d1c2d11Sd1c2d1c1d1c3610K", "0J61c3d1c1d1c2d1c1415Q41c1d1c2d1c1d1c3610J", "0Pd1c1d1c22Sc2d1c1d1c2d1c2610J", "02a902a303a501c1d1c32Sc3d1c1d1c2d1c2610I", "02a901a501a502c1d1c261425O4261c2d1c2d1c1d1c3610H", "02a901a501a501662S6D0H", "02a901a501a501c1d1c26101611Q610161c2d1c2d1c1d1c3610G", "06a502a301a502d1c3610161435K43610161c3d1c1d1c2d1c2610G", "06a506a501d1c26202612Q610262c2d1c1d1c1d1c2610G", "06a505a502c26105612O610561c2d1c1d1c1d1c2610F", "06a505a501c26106614754425447610661c2d1c1d2c3610E", "06a504a502c16108612M610861c2d2c1d1c1610F", "06a504a5016209611M610962c1d3c1610F", "06a504a50D614K610C650G", "0Y612I610Y", "0Z612G610Z", "0a624C620a")
AV_DYN = array.from("0XN20IN20X", "0YN20GN20Y", "0ZN30CN30Z", "0bN20AN20b", "0cN208N20c", "0dN206N20d", "0.0P", "0.0P", "0.0P", "0.0P", "0ME70UE70M", "0LE90SE90L", "0KEB0QEB0K", "0JED04Q102K304K302Q104ED0J", "0IEF03Q101K502K501Q103EF0I", "0IEF02L1Q1L1K502K5L1Q1L102EF0I", "0IEF01L2Q1L1K404K4L1Q1L201EF0I", "0HEGL3Q1L201K204K201L2Q1L3EG0H", "0HEGL3Q1L3K204K2L3Q1L3EG0H", "0HEGL7K204K2L7EG0H", "0HEGL701K202K201L7EG0H", "0HEGL701K202K201L7EG0H", "0IEFL7C8L7EF0I", "0IEF01L5CAL501EF0I", "0JED02L4P1CAP1L402ED0J", "0JED06P102C2G2C202P106ED0J", "0KEB07P104G204P107EB0K", "0LE908P104G204P108E90L", "01X90DE50AP104G204P10AE50DX901", "01XC0PP104G204P10PXC01", "03XD0MP104G204P10MXD03", "04XE0KP104G204P10KXE04", "06XB130IP104G204P10I13XB06", "08X713X1130GP104G204P10G13X113X708", "03M205X214X5130JG20J13X514X205M203", "0A13XA12X10HG20HX112XA130A", "081303XA13X10FG20FX113XA031308", "061307XA13X10DG20DX113XA071306", "0JX9130CG20C13X90J", "0LX912X10AG20AX112X90L", "0NX813X108G208X113X80N", "0QX6011307G2071301X60Q", "0SX4031204G6041203X40S", "0bG504G50b", "0XG50CG50X", "0E250BG40KG40B250E", "05M2052303280a28032305M205", "0B220C280M280C220B", "092306XB03250E2503XB062309", "082201XH0WXH012208", "04X322XC0kXC22X304", "X523X60NW308W30NX623X5", "04220TW508W50T2204", "02230UW508W50U2302", "01220VW50AW50V2201", "0WW332W20AW232W30W", "0VW134W205A205W234W10V", "0V32W502A802W5320V", "0S34W501AC01W5340S", "07M20I32W8AEW8320IM207", "0O34W8A506A5W8340O", "0N3202W9A30AA3W902320N", "0K3402W9A30CA3W902340K", "0J3204W901A20EA201W904320J", "0I3204W901A30EA301W904320I", "0H3205W901A20GA201W905320H", "0G3205W902A20GA202W905320G", "0F3205W903A20GA203W905320F", "0E3205W904A20GA204W905320E", "0PW603A20GA203WB05320D", "0PW405A20GA205W906320C", "0PW306A30EA306W906320B", "0YA30EA30M320A", "0OW307A40CA407W9073209", "0OW307A40CA407W9083208", "0NW309A40AA409W90H", "0NW20AA606A60AW90G", "0MW20CAG0CW90F", "0MW10EAE0EW70G", "0cAC0HW50G", "0dAA0d", "0fA60f", "0.0P", "0.0P")
avPal(string ch) => ch == "1" ? #141821 : ch == "2" ? #1B1F29 : ch == "3" ? #232834 : ch == "4" ? #2C3340 : ch == "5" ? #39414F : ch == "6" ? #495265 : ch == "7" ? #6A7285 : ch == "8" ? #0C0F15 : ch == "9" ? #171D29 : ch == "a" ? #D1D4DC : ch == "b" ? #3A1418 : ch == "c" ? #44648A : ch == "d" ? #9CC4E4 : ch == "e" ? #8892A4 : #0B0E14
//__END_AVATAR__
actOf(int g) => array.get(grpSize, g) > 0 ? array.get(grpSpk, g) / (array.get(grpSize, g) * stepsIn) : 0.0
avDim(string ch) => ch == "E" ? #8E2026 : ch == "L" ? #1B6C80 : ch == "K" ? #8A6B12 : ch == "C" ? #21398C : ch == "G" ? #7A1A20 : ch == "P" ? #106B4C : ch == "Q" ? #7A2080 : ch == "N" ? #6B5AA0 : ch == "A" ? #10402F : #8A5A16
avBright(string ch) => ch == "E" ? #FF4757 : ch == "L" ? #4DD0E1 : ch == "K" ? #FFD54F : ch == "C" ? #2962FF : ch == "G" ? #FF5252 : ch == "P" ? #19D49B : ch == "Q" ? #E040FB : ch == "N" ? #B388FF : ch == "A" ? #19D49B : #FFA726
expandRLE(string enc) =>
    out = ""
    i = 0
    n = str.length(enc)
    while i < n
        ch = str.substring(enc, i, i + 1)
        cnt = nz(str.pos(ALPHA, str.substring(enc, i + 1, i + 2)), 0)
        out := out + str.repeat(ch, cnt)
        i += 2
    out
spark(float[] h) =>
    s = ""
    i = 0
    while i < array.size(h)
        sv = array.get(h, i)
        k = math.min(7, math.max(0, math.round(sv * 7)))
        s := s + (k == 0 ? "▁" : k == 1 ? "▂" : k == 2 ? "▃" : k == 3 ? "▄" : k == 4 ? "▅" : k == 5 ? "▆" : k == 6 ? "▇" : "█")
        i += 1
    s
// Шаг выборки спрайта. Разрешение панели и скорость её анимации связаны
// напрямую: платформа перерисовывает тем реже, чем больше сетка таблицы.
SS = detailIn == "full" ? 1 : 2
GW = AV_W / SS
GH = AV_H / SS
CELL_W = cellWIn * SS
CELL_H = cellHIn * SS
PAD = 1
ROW_TITLE = 0
ROW_SUB1 = 1
ROW_SUB2 = 2
ROW_PADT = 3
ROW_AV = ROW_PADT + PAD
ROW_CAP = ROW_AV + GH
NCALL = 6                      // five readout rows plus one empty row as the gap before the footer
ROW_HEAD = ROW_CAP + 1
ROW_CALL = ROW_HEAD + 1
ROW_SESSION = ROW_CALL + NCALL
ROW_BRAND = ROW_SESSION + 1
ROW_PADB = ROW_BRAND + 1
N_ROWS = ROW_PADB + PAD
var table av = na
padR(string s, int n) => s + str.repeat(" ", math.max(0, n - str.length(s)))
padL(string s, int n) => str.repeat(" ", math.max(0, n - str.length(s))) + s
// One merged cell per row. Splitting a row into column groups would let the longest
// string stretch only those columns, and the fly's pixel grid is those same columns.
// Ширину панели задаёт самая длинная строка отчёта, а сетка спрайта под неё не
// тянется — излишек уходит пустым полем справа. Замер по снимку: текст 419 px
// против 344 px у мухи, шире на 75. Шапка 43 знака плюс примечание не длиннее
// 13 даёт 56 знаков и 345 px — ровно ширина спрайта.
avLine(string label, string circuit, string value, string note) =>
    " " + padR(label, 9) + padR(circuit, 20) + padL(value, 12) + " " + note
avRow(int i, string label, string circuit, string value, string note, color cl) =>
    table.cell(av, 0, ROW_CALL + i, avLine(label, circuit, value, note), text_color = cl, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)

var int[] dynX = array.new_int(0)
var int[] dynY = array.new_int(0)
var string[] dynK = array.new_string(0)
var string[] dynBase = array.new_string(0)
var float[] loomHist = array.new_float(5, 0.0)      // 5, не 10: искра должна войти в 13 знаков
var float mmStart = na
var float firstClose = na
if na(firstClose) and barstate.isconfirmed
    firstClose := close
brainPos = placeIn == "top left" ? position.top_left : placeIn == "top center" ? position.top_center : placeIn == "top right" ? position.top_right : placeIn == "middle left" ? position.middle_left : placeIn == "middle right" ? position.middle_right : placeIn == "bottom left" ? position.bottom_left : placeIn == "bottom center" ? position.bottom_center : position.bottom_right
if useReflex and barstate.isconfirmed and phase == 3
    array.shift(loomHist)
    array.push(loomHist, math.min(1.0, actOf(5) * 25.0))
if showBrain and barstate.islast
    if na(av)
        av := table.new(brainPos, GW, N_ROWS, bgcolor = color.new(#05070A, 0), border_width = 0, frame_color = color.new(#2962FF, 88), frame_width = 1, force_overlay = true)
        table.cell(av, 0, ROW_TITLE, "THE FLY THAT TRADES", text_color = color.new(#D1D4DC, 0), text_size = size.large, text_halign = text.align_center)
        table.merge_cells(av, 0, ROW_TITLE, GW - 1, ROW_TITLE)
        table.cell(av, 0, ROW_SUB1, "A brain where every named circuit votes:", text_color = color.new(#787B86, 0), text_size = size.small, text_halign = text.align_center)
        table.merge_cells(av, 0, ROW_SUB1, GW - 1, ROW_SUB1)
        table.cell(av, 0, ROW_SUB2, str.tostring(N_NEUR) + " neurons, " + str.tostring(E) + " measured connections.", text_color = color.new(#787B86, 0), text_size = size.small, text_halign = text.align_center)
        table.merge_cells(av, 0, ROW_SUB2, GW - 1, ROW_SUB2)
        table.merge_cells(av, 0, ROW_CAP, GW - 1, ROW_CAP)
        table.merge_cells(av, 0, ROW_SESSION, GW - 1, ROW_SESSION)
        table.merge_cells(av, 0, ROW_BRAND, GW - 1, ROW_BRAND)
        // readout as a real table: four aligned columns, no grid lines
        table.merge_cells(av, 0, ROW_HEAD, GW - 1, ROW_HEAD)
        table.cell(av, 0, ROW_HEAD, avLine("CIRCUIT", "NEURONS", "SIGNAL", "STATE"), text_color = color.new(#5D606B, 0), text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace)
        rr = 0
        while rr < NCALL
            table.merge_cells(av, 0, ROW_CALL + rr, GW - 1, ROW_CALL + rr)
            rr += 1
        pr = 0
        while pr < PAD
            table.merge_cells(av, 0, ROW_PADT + pr, GW - 1, ROW_PADT + pr)
            table.merge_cells(av, 0, ROW_PADB + pr, GW - 1, ROW_PADB + pr)
            table.cell(av, 0, ROW_PADT + pr, "", height = CELL_H)
            table.cell(av, 0, ROW_PADB + pr, "", height = CELL_H)
            pr += 1
        r = 0
        while r < GH
            sr = r * SS
            rs = expandRLE(array.get(AV_STATIC, sr))
            rd = expandRLE(array.get(AV_DYN, sr))
            // В половинном режиме блок 2x2 сворачивается в одну клетку: берём
            // непрозрачную точку, а из двух непрозрачных — ту, что повторяется.
            // Просто «левая верхняя» теряла бы однопиксельные детали: усики,
            // блики на глазах и тонкие лапы.
            rs2 = SS > 1 and sr + 1 < AV_H ? expandRLE(array.get(AV_STATIC, sr + 1)) : rs
            rd2 = SS > 1 and sr + 1 < AV_H ? expandRLE(array.get(AV_DYN, sr + 1)) : rd
            c = 0
            while c < GW
                sx = c * SS
                sc = str.substring(rs, sx, sx + 1)
                dk = str.substring(rd, sx, sx + 1)
                if SS > 1
                    a1 = str.substring(rs, sx + 1, sx + 2)
                    a2 = str.substring(rs2, sx, sx + 1)
                    a3 = str.substring(rs2, sx + 1, sx + 2)
                    sc := sc != "0" and (sc == a1 or sc == a2 or sc == a3) ? sc : a2 != "0" and (a2 == a1 or a2 == a3) ? a2 : sc != "0" ? sc : a1 != "0" ? a1 : a2 != "0" ? a2 : a3
                    b1 = str.substring(rd, sx + 1, sx + 2)
                    b2 = str.substring(rd2, sx, sx + 1)
                    b3 = str.substring(rd2, sx + 1, sx + 2)
                    dk := dk != "0" and (dk == b1 or dk == b2 or dk == b3) ? dk : b2 != "0" and (b2 == b1 or b2 == b3) ? b2 : dk != "0" ? dk : b1 != "0" ? b1 : b2 != "0" ? b2 : b3
                table.cell(av, c, ROW_AV + r, "", width = CELL_W, height = CELL_H, bgcolor = sc == "0" ? color.new(#05070A, 100) : color.new(avPal(sc), 0))
                if dk != "0"
                    array.push(dynX, c)
                    array.push(dynY, r)
                    array.push(dynK, dk)
                    array.push(dynBase, sc)
                c += 1
            r += 1
    // ── live state → intensities ──
    escaping = cooldown > 0
    walking = strategy.position_size > 0 and not escaping
    liveLoom = math.min(1.0, liveStim * 0.9)
    // Множители откалиброваны по замеренной активности: типичное значение actOf
    // должно давать ~0.15–0.2: приглушённый фон и запас на вспышку. При ~0.5 глаза
    // горели постоянно и панель слепила. Замер actOf: loom 0.00076, побег 0.0023,
    // MBON 0.043, кольцо 0.336, PFL3 0.047.
    loomLvl = math.max(liveLoom, math.min(1.0, actOf(5) * 150.0))
    eyeLvl  = math.max(loomLvl, escaping ? 1.0 : 0.12)
    kcLvl   = math.max(0.15, math.min(1.0, actOf(7) * 5.0))          // выход памяти
    hdLvl   = math.max(0.15, math.min(1.0, actOf(12) * 0.6))           // кольцо компаса
    cxLvl   = math.max(0.15, math.min(1.0, actOf(14) * 4.0))          // PFL3, сравнение курса с целью
    gfLvl   = escaping or gfSpikes >= gfMinIn ? 1.0 : math.max(0.10, math.min(1.0, actOf(0) * 80.0))
    pamLvl  = math.min(1.0, pamNow / 1.5)
    pplLvl  = math.min(1.0, pplNow / 1.5)
    // Волна идёт от головы к брюшку, на побеге быстрее.
    //
    // Фаза считается от часов, а не от счётчика тиков. Тик — это перерисовка, и
    // как часто она случается, решает платформа: замер дал один тик в 8–12 секунд
    // в фоновой вкладке и заметно чаще в активной, причём от веса скрипта это не
    // зависело (при 300 барах вместо 1200 темп тот же). Привязка к тикам давала
    // либо застывшую муху, либо мельтешение — в зависимости от того, смотрит
    // пользователь на вкладку или нет. От часов поза едет с постоянной скоростью,
    // а редкие тики просто выбрасывают кадры, как в кино с пропусками.
    // Замер частоты перерисовки: 1 пересчёт в 8–12 секунд, и это не зависит ни
    // от веса скрипта (300 баров вместо 1200 дали тот же темп), ни от стоимости
    // отрисовки (с полностью отключённым циклом пикселей — тот же темп), ни от
    // того, активно окно или нет. Столько платформа даёт стратегии в реальном
    // времени. Значит задача анимации — не плавность, а чтобы каждый редкий кадр
    // отличался от предыдущего. Период цикла 2.6 с при шаге перерисовки ~9 с даёт
    // сдвиг примерно на 40 % цикла за кадр: движение видно и не вырождается.
    frame = math.floor(timenow / 220)          // ~4.5 кадра в секунду
    period = escaping ? 8 : 12                 // полный проход волны за 1.8–2.6 с
    wave = (frame % period) / (period * 1.0)
    breath = 0.5 + 0.5 * math.sin(frame * 6.2832 / period)
    i = 0
    nd = array.size(dynX)
    while i < nd
        k = array.get(dynK, i)
        x = array.get(dynX, i)
        y = array.get(dynY, i)
        col = color.new(avPal(array.get(dynBase, i)), array.get(dynBase, i) == "0" ? 100 : 0)
        if k == "W"
            // blend, never replace: a flat overlay here wipes out the wing art underneath.
            // Крылья дышат вместе со всем телом; на побеге сложенные крылья гаснут,
            // потому что их подменяют расправленные (класс X).
            col := escaping ? col : color.from_gradient(0.05 + 0.30 * breath, 0.0, 1.0, col, #CFE6FF)
        else if k == "X"
            col := escaping ? color.new(#FFB74D, 25 + math.round(20 * (1 - breath))) : col
        else if k == "M"
            col := escaping ? color.new(#FFB74D, math.round(60 * (1 - breath))) : col
        else if k == "1" or k == "2" or k == "3"
            // Треножная походка, как у настоящего насекомого: передняя и задняя
            // лапы одной стороны шагают вместе со средней лапой другой, потом
            // наоборот — три точки опоры всегда на земле. Сторону берём из
            // положения клетки, отдельного признака для неё в спрайте нет.
            tri = (k == "1" or k == "3") == (x < GW / 2)
            up = (frame % 2 == 0) == tri
            // Стоящая муха тоже перебирает лапами, просто тише: при выходе из
            // рынка контраст слабее, в рынке — полный шаг.
            col := walking ? (up ? color.new(#D9922F, 4) : color.new(#6B400F, 22)) : (up ? color.new(#9A6520, 12) : color.new(#73440F, 20))
        else
            lv = k == "E" ? eyeLvl : k == "L" ? loomLvl : k == "K" ? kcLvl : k == "C" ? cxLvl : k == "G" ? gfLvl : k == "P" ? pamLvl : k == "Q" ? pplLvl : k == "A" ? math.max(pamLvl, pplLvl) : k == "N" ? hdLvl : 0.2
            ph = y / GH
            d = math.abs(ph - wave)
            // Полоса шире прежней: при шести кадрах на цикл узкая полоса просто
            // перескакивала мимо большей части тела, и движения не было видно.
            pulse = d < 0.24 ? 1.0 - d / 0.24 : 0.0
            // Усики живут своим темпом — они самая подвижная часть у живой мухи.
            tw = k == "N" ? 0.30 * breath : 0.0
            // the circuit is always drawn in its own colour; activity and the travelling pulse only brighten it
            // Нижний порог был 0.55: любой контур всегда светился больше чем
            // наполовину, и панель выглядела кислотной независимо от того, что
            // в сети происходит. Покой — тёмный, вспышка — во всю яркость.
            // Свет сверху-слева. Без него крупные однотонные заливки — прежде
            // всего глаза — читаются как наклейки, а не как объём: пиксель-арт
            // держится на том, что одна и та же краска сверху светлее, чем снизу.
            lit = 0.80 + 0.40 * (1.0 - (x * 1.0 / GW + y * 1.0 / GH) * 0.5)
            hot = math.min(1.0, (0.17 + 0.63 * lv + 0.30 * pulse * (0.3 + lv) + tw) * lit)
            col := k == "A" ? color.new(avBright(k), 82 - math.round(math.min(1.0, lv) * 62)) : color.new(color.from_gradient(hot, 0.0, 1.0, avDim(k), avBright(k)), 0)
        table.cell(av, x, ROW_AV + y, "", width = CELL_W, height = CELL_H, bgcolor = col)
        i += 1
    // ── caption + lab-style readout ──
    st = escaping ? 2 : strategy.position_size > 0 ? 1 : 0
    table.cell(av, 0, ROW_CAP, st == 2 ? "💨  ESCAPING — flat " + str.tostring(cooldown) + " bars" : st == 1 ? "🚶  WALKING — long" : "🧼  GROOMING — out", text_color = st == 2 ? color.new(#F23645, 0) : st == 1 ? color.new(#089981, 0) : color.new(#D1D4DC, 0), text_size = size.large, text_halign = text.align_center)
    dimC = color.new(#787B86, 0)
    onC  = color.new(#D1D4DC, 0)
    mm = 0.0
    q = 0
    nk = array.size(kmEdges)
    while q < nk
        mm += array.get(mA, array.get(kmEdges, q))
        q += 1
    mm := nk > 0 ? mm / nk : 1.0
    if na(mmStart)
        mmStart := mm
    loomPct = actOf(5) * 100.0
    misRad = wrapPi(heading - goalRad)
    misDeg = misRad * 180.0 / math.pi
    avRow(0, "vision", "LC4 / LPLC2 · " + str.tostring(N_LOOM), str.tostring(math.max(loomPct, liveLoom * 100), "#.#") + " %", (liveLoom > 0.02 or loomPct > 2 ? "looming" : "quiet") + " " + spark(loomHist), liveLoom > 0.02 or loomPct > 2 ? onC : dimC)
    avRow(1, "escape", "DNp01 giant fiber", str.tostring(gfSpikes) + " / " + str.tostring(gfMinIn) + " spikes", gfSpikes >= gfMinIn ? "FIRED → out" : escaping ? "out " + str.tostring(cooldown) + " bars" : "armed", gfSpikes >= gfMinIn or escaping ? color.new(#F23645, 0) : dimC)
    avRow(2, "compass", "EPG ring · " + str.tostring(array.size(epgIdx)), str.tostring(misDeg, "#") + "°", math.abs(misDeg) < 45 ? "on course" : math.abs(misDeg) < 120 ? "drifting" : "facing away", math.abs(misDeg) < 45 ? onC : dimC)
    avRow(3, "steering", "PFL3 → DNa02", str.tostring(turnLR, "#.#"), saidBy == "turn" ? "by compass" : saidBy == "backward" ? "MDN → out" : saidBy == "groom" ? "DNg11 grooms" : saidBy == "forward" ? "DNp09 walks" : saidBy, saidBy == "hold" or saidBy == "warmup" ? dimC : onC)
    avRow(4, "memory", "Kenyon → MBON · " + str.tostring(array.size(kmEdges)), str.tostring(mm * 100, "#.#") + " %", "−" + str.tostring((1 - mm) * 100, "#.#") + " % gone", mm < 0.995 ? onC : dimC)
    avRow(5, "dopamine", "PAM / PPL1 dopamine", str.tostring(pamNow, "#.##") + " / " + str.tostring(pplNow, "#.##"), pamNow > 0.5 ? "paid off" : pplNow > 0.5 ? "that one hurt" : "—", pamNow > 0.5 ? color.new(#089981, 0) : pplNow > 0.5 ? color.new(#E040FB, 0) : dimC)
    table.cell(av, 0, ROW_SESSION, "REAL wiring, MODELED firing  ·  " + str.tostring(stepsIn) + " steps/bar  ·  not advice", text_color = color.new(#5D606B, 0), text_size = size.tiny, text_halign = text.align_center)
    table.cell(av, 0, ROW_BRAND, "TradingView  ·  MaleCNS v1.0", text_color = color.new(#2962FF, 0), text_size = size.normal, text_halign = text.align_center)
