// FlyTV — a real fruit fly connectome trading on your chart
//
// 1,329 neurons and 20,000 measured connections of an adult male Drosophila melanogaster
// (MaleCNS v1.0), distilled to fit Pine Script and wired into a trading strategy.
//
// Unlike the previous version, every named circuit now takes part in the decision:
//   · LC4 / LPLC2 looming detectors → DNp01, the giant fiber → escape, go flat
//   · LC9 → DNp09 → walk forward → go long
//   · a ring attractor of EPG cells holds the market's direction as a bump of activity;
//     FC2 carries the goal, PFL3 compares the two and steers DNa02
//   · MDN and DNg11 are read by release from inhibition, not by spikes — that is how
//     their circuits signal: both sit under net inhibition in the connectome
//   · Kenyon cells → MBON form the memory; what it learns reaches the steering system
//     through 16 measured synaptic connections, not through a term in our code
//
// REAL: the wiring, synapse counts, neurotransmitter signs, the ring geometry (recovered
// from connectivity alone), and the paths from memory to the command neurons.
// MODELED: spiking dynamics, how a candle becomes a stimulus, how spikes become an order.
// This is a visualization of measured neuroscience, not a validation of fly physiology —
// and not financial advice. It does not beat buy & hold; see the description.
//
// Data: MaleCNS v1.0, CC BY 4.0 — FlyEM/HHMI Janelia, University of Cambridge, MRC LMB,
// Google Research. Berg et al., doi:10.1101/2025.10.09.680999
strategy("FlyTV - a real fruit fly connectome trading on your chart", "FlyTV", overlay = false, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.02, process_orders_on_close = false, calc_on_every_tick = true, calc_bars_count = 1200)

// ── Inputs ───────────────────────────────────────────────────────────────────
gMode   = "Mode"
modeIn  = input.string("whole brain", "Version", options = ["buy&hold", "escape reflex only", "whole brain"], group = gMode, tooltip = "\"Escape reflex only\" keeps just the looming pathway and the giant fiber — 313 of the neurons. On the reference model that version reproduced the whole brain's trades exactly; after this rebuild it no longer does, which is the point of the update.", display = display.none)
gBody   = "Layer 2 — body interface (the only tuned numbers)"
gainIn  = input.float(4.0, "Looming: gain", step = 0.5, group = gBody, display = display.none)
downIn  = input.float(1.0, "Looming: weight of a drop", step = 0.1, group = gBody, display = display.none)
upIn    = input.float(0.3, "Looming: weight of a rise", step = 0.1, group = gBody, display = display.none)
rngIn   = input.float(0.5, "Looming: weight of bar range", step = 0.1, group = gBody, display = display.none)
stepsIn = input.int(10, "Network steps per bar", minval = 1, maxval = 40, group = gBody, tooltip = "10 rather than the reference model's 20: a working brain costs twice the platform budget. Measured cost of the halving: with the ring readout the reference makes 98 entries and +28% at both 10 and 20 steps, so the compass is insensitive to it. The four-cell DNa02 difference is not — it is the readout this script no longer steers by.", display = display.none)
gfMinIn = input.int(3, "GF spikes to escape", minval = 1, group = gBody, display = display.none)
cdIn    = input.int(24, "Escape: bars out of market", minval = 1, group = gBody, display = display.none)
hdGain  = input.float(1.2, "Compass: drive into the EPG ring", step = 0.2, group = gBody, display = display.none)
hdKappa = input.float(2.0, "Compass: width of the activity bump", step = 0.5, group = gBody, display = display.none)
goalDeg = input.float(45.0, "Goal direction, degrees", step = 15.0, group = gBody, tooltip = "The direction FC2 holds as the goal. 45 degrees means both the fast and the slow momentum pointing up.", display = display.none)
goalGain = input.float(1.0, "Goal: drive into FC2", step = 0.2, group = gBody, display = display.none)
fastK   = input.int(4, "Fast momentum, bars", minval = 1, group = gBody, display = display.none)
slowK   = input.int(24, "Slow momentum, bars", minval = 2, group = gBody, display = display.none)
fwdGain = input.float(1.5, "Forward drive into LC9", step = 0.25, group = gBody, display = display.none)
revGain = input.float(1.5, "Reverse drive into MDN inputs", step = 0.25, group = gBody, display = display.none)
grmGain = input.float(1.0, "Quiet-market drive into DNg11 inputs", step = 0.25, group = gBody, display = display.none)
steerTol = input.float(90.0, "Steering: hold long while heading is within (degrees of goal)", step = 15.0, group = gBody, tooltip = "Read from the ring population, not from the four DNa02 cells: the ring fires ~600 spikes a bar and survives distillation, the four-cell difference does not.", display = display.none)
relZ    = input.float(1.0, "Release threshold for MDN / DNg11 (z of their own history)", step = 0.25, group = gBody, tooltip = "Both sit under net inhibition and almost never spike. They are read by how far the pressure on them has lifted, measured against their own past.", display = display.none)
warmIn  = input.int(200, "Bars before the release readout starts", minval = 20, group = gBody, display = display.none)
kcGain  = input.float(0.6, "Memory: drive into active Kenyon cells", step = 0.1, group = gBody, display = display.none)
kcZ     = input.float(1.04, "Memory: sparseness threshold (z)", step = 0.05, group = gBody, tooltip = "How far above the mean a Kenyon cell has to be driven to join the code. 1.04 leaves about 15% of them active — roughly 105 cells, the number that matters downstream.", display = display.none)
danGain = input.float(0.8, "Memory: dopamine drive", step = 0.1, group = gBody, display = display.none)
etaIn   = input.float(0.05, "Memory: depression rate (eta)", step = 0.01, group = gBody, display = display.none)
gammaIn = input.float(0.002, "Memory: recovery per bar (gamma)", step = 0.001, group = gBody, display = display.none)
gLif    = "Neuron model"
decayIn = input.float(0.90, "Potential decay per step", step = 0.01, group = gLif, display = display.none)
thIn    = input.float(1.0, "Firing threshold", step = 0.1, group = gLif, display = display.none)
wScale  = input.float(500.0, "Synaptic contacts → current: divisor", step = 100, group = gLif, tooltip = "At 2000 — the previous value — the network did not conduct past its first layer: 53% of neurons never fired and the brain averaged 0.7 spikes per bar. This is the single number that woke it up.", display = display.none)
noiseN  = input.int(20, "Noise injections per step", group = gLif, display = display.none)
noiseA  = input.float(0.30, "Noise amplitude", step = 0.05, group = gLif, display = display.none)
chunkIn = input.int(2000, "Build: edges parsed per bar", minval = 100, group = gLif, display = display.none)
gView   = "View"
showBrain = input.bool(true, "Brain window on the price chart (animates on the live bar)", group = gView, display = display.none)
detailIn  = input.string("full", "Pixel detail", options = ["full", "half — animates 4x faster"], group = gView, tooltip = "How often the panel repaints is set by the size of the table grid, and by nothing else. Measured on this chart: no panel at all repaints once a second, 44x42 once every 7 seconds, 88x84 once every 14. Script weight does not matter (a 72M-operation dummy still repaints once a second), and neither does how many cells are rewritten per frame (skipping every rewrite changed nothing). Half takes the prevailing point of each 2x2 block, so the silhouette, legs, wings and brain stay readable.", display = display.none)
cellWIn   = input.float(0.27, "Pixel width (% of chart width)", step = 0.02, minval = 0.05, group = gView, display = display.none)
cellHIn   = input.float(0.58, "Pixel height (% of pane height)", step = 0.02, minval = 0.1, group = gView, tooltip = "The sprite is 88x84 cells, so cells must be square. Width % is of pane width and height % is of pane height, so the right value depends on your pane shape: height = width x (pane width / pane height). On a 1488x689 pane that is 0.27 x 2.16 = 0.58. Raise it if the fly looks flattened, lower it if stretched.", display = display.none)
placeIn   = input.string("middle right", "Brain placement", options = ["top left", "top center", "top right", "middle left", "middle right", "bottom left", "bottom center", "bottom right"], group = gView, tooltip = "Middle right sits in the empty space right of the last bar — leave a right margin on the chart (drag the time axis).", display = display.none)

// ── Embedded data (written by the generator) ─────────────────────────────────
