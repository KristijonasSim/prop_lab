// prop_lab: fetched from TradingView 2026-10-08
// url: https://www.tradingview.com/script/gOQ0eQvL-ULTIMATE-TEMA-LSMA-INSTITUTIONAL-DAVIN-MA-Ahtisham-Qureshi/
// id: PUB;f173cae314844be8bfefa96f5f315699  kind: strategy  likes: 103
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
