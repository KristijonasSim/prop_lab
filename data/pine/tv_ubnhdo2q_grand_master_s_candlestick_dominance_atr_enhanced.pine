    array.set(neutralPatternResults, 0, isDojiCandle(open, close, high, low, atrValue, smallBodyAtrMult, 0.1))
    array.set(neutralPatternResults, 1, isLongLeggedDoji)
    array.set(neutralPatternResults, 2, isFourPriceDoji)
    array.set(neutralPatternResults, 3, isSpinningTop)
    array.set(neutralPatternResults, 4, isGappingDoji)
    array.set(neutralPatternResults, 5, isHaramiCrossBull)
    array.set(neutralPatternResults, 6, isHaramiCrossBear)
    array.set(neutralPatternResults, 7, isUpsideTasukiGap)
    array.set(neutralPatternResults, 8, isOnNeckLine)
    array.set(neutralPatternResults, 9, isInNeckLine)
    array.set(neutralPatternResults, 10, is3BarInsideBull)
    array.set(neutralPatternResults, 11, is3BarInsideBear)
    array.set(neutralPatternResults, 12, isHomingPigeon)
    array.set(neutralPatternResults, 13, isLastEngulfingBottom)
    array.set(neutralPatternResults, 14, isLastEngulfingTop)
    array.set(neutralPatternResults, 15, isCounterattackBull)
    array.set(neutralPatternResults, 16, isCounterattackBear)
    array.set(neutralPatternResults, 17, isThreeStarsSouth)
    array.set(neutralPatternResults, 18, is3StarsNorth)
    array.set(neutralPatternResults, 19, isSqueezeAlert)
    array.set(neutralPatternResults, 20, isStalledPattern)
    array.set(neutralPatternResults, 21, isUpsideDownsideGap3Bull)
    array.set(neutralPatternResults, 22, isUpsideDownsideGap3Bear)
    array.set(neutralPatternResults, 23, isEngulfingDoji)
    array.set(neutralPatternResults, 24, isHighWaveCandle)
    array.set(neutralPatternResults, 25, isOneBarReversalBull)
    array.set(neutralPatternResults, 26, isOneBarReversalBear)
    array.set(neutralPatternResults, 27, isThreeGapUp)
    array.set(neutralPatternResults, 28, isThreeGapDown)
    array.set(neutralPatternResults, 29, isTwoCrows)
    array.set(neutralPatternResults, 30, isMorningDojiStar)
    array.set(neutralPatternResults, 31, isEveningDojiStar)
    array.set(neutralPatternResults, 32, isAdvancingBlock)
    array.set(neutralPatternResults, 33, isKickingIndecision)

fillPatternArrays()

// Call pattern fill


// -----------------------------------------------------------------------------
// TREND & CONFIRMATION LOGIC
// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// TREND & CONFIRMATION LOGIC (Updated)
// -----------------------------------------------------------------------------
maType = input.string("SMA", "Trend MA Type", options=["SMA", "EMA"], group="Trend Filters")

// Primary Trend MA
ma = maType == "EMA" ? ta.ema(close, maLength) : ta.sma(close, maLength)
isUptrend   = close > ma
isDowntrend = close < ma

// Volume Confirmation
float avgVolume = ta.sma(volume, volumeMALength)
bool isVolumeSpike = enableVolumeConfirmation ? volume > avgVolume * volumeSpikeMultiplier : true

// Support / Resistance Confirmation
float ph = ta.pivothigh(high, swingPivotLength, swingPivotLength)
float pl = ta.pivotlow(low, swingPivotLength, swingPivotLength)

bool isNearSupport    = not enableSRConfirmation or (not na(pl[1]) and low >= pl[1] * (1 - srTolerancePerc) and low <= pl[1] * (1 + srTolerancePerc))

bool isNearResistance = not enableSRConfirmation or (not na(ph[1]) and high <= ph[1] * (1 + srTolerancePerc) and high >= ph[1] * (1 - srTolerancePerc))

// Follow-Through Confirmation
bool isFollowThroughBullish = not enableAdvancedFollowThrough or (followThroughType == "Bullish/Bearish Candle"  ? close > open : followThroughType == "Close Beyond Previous"   ? close > close[1] : true)

bool isFollowThroughBearish = not enableAdvancedFollowThrough or (followThroughType == "Bullish/Bearish Candle"  ? close < open : followThroughType == "Close Beyond Previous"   ? close < close[1] : true)

// Higher Timeframe Trend Filter (with proper lookahead)
float htf_ma = request.security(syminfo.tickerid, higherTimeframe, maType == "EMA" ? ta.ema(close, higherTFMALength) : ta.sma(close, higherTFMALength), lookahead = barmerge.lookahead_on)

bool isHTFUptrend   = not enableMTFFilter or close > htf_ma
bool isHTFDowntrend = not enableMTFFilter or close < htf_ma

// Pattern strength calculations
int bullishCount = 0
float bullishStrengthSum = 0.0
string recentBullPattern = ""
float recentBullStrength = 0.0
int recentBullDuration = 0
for i = 0 to array.size(bullishPatternResults) - 1
    if array.get(bullishPatternResults, i) and array.get(bullishPatternStrengths, i) >= minPatternStrength
        bullishCount += 1
        bullishStrengthSum += array.get(bullishPatternStrengths, i)
        if recentBullPattern == "" or array.get(bullishPatternStrengths, i) > recentBullStrength
            recentBullPattern := array.get(bullishPatternNames, i)
            recentBullStrength := array.get(bullishPatternStrengths, i)
            recentBullDuration := array.get(bullishPatternDurations, i)

float avgBullishStrength = bullishCount > 0 ? bullishStrengthSum / bullishCount : 0

int bearishCount = 0
float bearishStrengthSum = 0.0
string recentBearPattern = ""
float recentBearStrength = 0.0
int recentBearDuration = 0
for i = 0 to array.size(bearishPatternResults) - 1
    if array.get(bearishPatternResults, i) and array.get(bearishPatternStrengths, i) >= minPatternStrength
        bearishCount += 1
        bearishStrengthSum += array.get(bearishPatternStrengths, i)
        if recentBearPattern == "" or array.get(bearishPatternStrengths, i) > recentBearStrength
            recentBearPattern := array.get(bearishPatternNames, i)
            recentBearStrength := array.get(bearishPatternStrengths, i)
            recentBearDuration := array.get(bearishPatternDurations, i)

float avgBearishStrength = bearishCount > 0 ? bearishStrengthSum / bearishCount : 0

int neutralCount = 0
float neutralStrengthSum = 0.0
string recentNeutralPattern = ""
float recentNeutralStrength = 0.0
int recentNeutralDuration = 0
for i = 0 to array.size(neutralPatternResults) - 1
    if array.get(neutralPatternResults, i) and array.get(neutralPatternStrengths, i) >= minPatternStrength
        neutralCount += 1
        neutralStrengthSum += array.get(neutralPatternStrengths, i)
        if recentNeutralPattern == "" or array.get(neutralPatternStrengths, i) > recentNeutralStrength
            recentNeutralPattern := array.get(neutralPatternNames, i)
            recentNeutralStrength := array.get(neutralPatternStrengths, i)
            recentNeutralDuration := array.get(neutralPatternDurations, i)

float avgNeutralStrength = neutralCount > 0 ? neutralStrengthSum / neutralCount : 0

// Entry Conditions
bool longCondition  = avgBullishStrength >= minAvgStrength and avgBearishStrength < minAvgStrength and isUptrend and isVolumeSpike and isNearSupport and isFollowThroughBullish and isHTFUptrend
bool shortCondition = avgBearishStrength >= minAvgStrength and avgBullishStrength < minAvgStrength and isDowntrend and isVolumeSpike and isNearResistance and isFollowThroughBearish and isHTFDowntrend

// -----------------------------------------------------------------------------
// TRADE MANAGEMENT SYSTEM
// -----------------------------------------------------------------------------
total_qty_pct = tp1_qty_pct + tp2_qty_pct + tp3_qty_pct + runner_qty_pct
tp1_qty_adj = total_qty_pct > 0 ? math.round(tp1_qty_pct * 100 / total_qty_pct) : 0
tp2_qty_adj = total_qty_pct > 0 ? math.round(tp2_qty_pct * 100 / total_qty_pct) : 0
tp3_qty_adj = total_qty_pct > 0 ? math.round(tp3_qty_pct * 100 / total_qty_pct) : 0
runner_qty_adj = 100 - (tp1_qty_adj + tp2_qty_adj + tp3_qty_adj)
// -----------------------------------------------------------------------------
//                             STRATEGY LOGIC
// -----------------------------------------------------------------------------
// MODIFICATION: Added variables to track exit price and time
var float lastLongEntryPrice = na, var int lastLongEntryTime = na
var float lastShortEntryPrice = na, var int lastShortEntryTime = na
var float lastLongExitPrice = na, var int lastLongExitTime = na
var float lastShortExitPrice = na, var int lastShortExitTime = na


var float  long_entry_price   = na
var float  short_entry_price  = na
var float  long_highest       = na
var float  short_lowest       = na
var float  long_trailing_sl   = na
var float  short_trailing_sl  = na
var float  long_trail_base    = na
var float  short_trail_base   = na
var bool   long_tp_hit        = false
var bool   short_tp_hit       = false

var line line_entry_long  = na
var line line_entry_short = na
var line line_tp1_long    = na
var line line_tp2_long    = na
var line line_tp3_long    = na
var line line_trail_long  = na
var line line_tp1_short   = na
var line line_tp2_short   = na
var line line_tp3_short   = na
var line line_trail_short = na


// Entry Logic
if useAsStrategy and inDateRange
    if longCondition and strategy.position_size <= 0
        strategy.cancel_all()
        strategy.close_all(comment="Exit Short → Enter Long")
        long_entry_price  := close
        long_highest      := close
        long_trail_base   := close
        long_trailing_sl  := close * (1 - sl_pct / 100)
        long_tp_hit       := false
        lastLongEntryPrice := close
        lastLongEntryTime := time
        strategy.entry("Long", strategy.long, comment="Long Entry")

        if show_levels
            line.delete(line_entry_long)
            line_entry_long := line.new(bar_index, close, bar_index + 1, close, color=color.yellow, width=2, style=line.style_dashed, extend=extend.right)
            label.new(bar_index, close, "LONG", color=color.green, textcolor=color.white, style=label.style_label_down, yloc=yloc.belowbar, size=size.small)

    if shortCondition and strategy.position_size >= 0
        strategy.cancel_all()
        strategy.close_all(comment="Exit Long → Enter Short")
        short_entry_price := close
        short_lowest      := close
        short_trail_base  := close
        short_trailing_sl := close * (1 + sl_pct / 100)
        short_tp_hit      := false
        lastShortEntryPrice := close
        lastShortEntryTime := time
        strategy.entry("Short", strategy.short, comment="Short Entry")

        if show_levels
            line.delete(line_entry_short)
            line_entry_short := line.new(bar_index, close, bar_index + 1, close, color=color.yellow, width=2, style=line.style_dashed, extend=extend.right)
            label.new(bar_index, close, "SHORT", color=color.red, textcolor=color.white, style=label.style_label_up, yloc=yloc.abovebar, size=size.small)

// Update trailing
if strategy.position_size > 0
    long_highest := math.max(long_highest, high)
    if trail_from_start or long_tp_hit
        long_trail_base := math.max(long_trail_base, high)
    long_trailing_sl := long_trail_base * (1 - sl_pct / 100)

if strategy.position_size < 0
    short_lowest := math.min(short_lowest, low)
    if trail_from_start or short_tp_hit
        short_trail_base := math.min(short_trail_base, low)
    short_trailing_sl := short_trail_base * (1 + sl_pct / 100)

// Detect TP hit
if strategy.position_size > 0
    int lastIdx = strategy.closedtrades - 1
    if lastIdx >= 0
        string comment = strategy.closedtrades.exit_comment(lastIdx)
        if not na(comment) and str.contains(comment, "TP")
            long_tp_hit := true

if strategy.position_size < 0
    int lastIdx = strategy.closedtrades - 1
    if lastIdx >= 0
        string comment = strategy.closedtrades.exit_comment(lastIdx)
        if not na(comment) and str.contains(comment, "TP")
            short_tp_hit := true

// Exit Orders
if strategy.position_size > 0 and useAsStrategy
    float entry = long_entry_price
    if use_partial_tp
        if tp1_qty_adj > 0
            strategy.exit("TP1 Long", "Long", qty_percent=tp1_qty_adj, limit=entry * (1 + tp1_pct / 100), comment="TP1 Long")
        if tp2_qty_adj > 0
            strategy.exit("TP2 Long", "Long", qty_percent=tp2_qty_adj, limit=entry * (1 + tp2_pct / 100), comment="TP2 Long")
        if tp3_qty_adj > 0
            strategy.exit("TP3 Long", "Long", qty_percent=tp3_qty_adj, limit=entry * (1 + tp3_pct / 100), comment="TP3 Long")
    else
        strategy.exit("Full TP Long", "Long", limit=entry * (1 + tp3_pct / 100), comment="Full TP Long")
    strategy.exit("Trail SL Long", "Long", stop=long_trailing_sl, comment="Trail SL Long")
    lastLongExitPrice := close
    lastLongExitTime := time

if strategy.position_size < 0 and useAsStrategy
    float entry = short_entry_price
    
    if use_partial_tp
        if tp1_qty_adj > 0
            strategy.exit("TP1 Short", "Short", qty_percent=tp1_qty_adj, limit=entry * (1 - tp1_pct / 100), comment="TP1 Short")
        if tp2_qty_adj > 0
            strategy.exit("TP2 Short", "Short", qty_percent=tp2_qty_adj, limit=entry * (1 - tp2_pct / 100), comment="TP2 Short")
        if tp3_qty_adj > 0
            strategy.exit("TP3 Short", "Short", qty_percent=tp3_qty_adj, limit=entry * (1 - tp3_pct / 100), comment="TP3 Short")
    else
        strategy.exit("Full TP Short", "Short", limit=entry * (1 - tp3_pct / 100), comment="Full TP Short")
    strategy.exit("Trail SL Short", "Short", stop=short_trailing_sl, comment="Trail SL Short")
    lastShortExitPrice := close
    lastShortExitTime := time
// Visual Levels
if show_levels and strategy.position_size > 0
    line.delete(line_tp1_long)
    line.delete(line_tp2_long)
    line.delete(line_tp3_long)
    line.delete(line_trail_long)
    line_tp1_long   := line.new(bar_index-50, long_entry_price * (1 + tp1_pct / 100), bar_index+10, long_entry_price * (1 + tp1_pct / 100), color=color.green, style=line.style_dotted, extend=extend.right)
    line_tp2_long   := line.new(bar_index-50, long_entry_price * (1 + tp2_pct / 100), bar_index+10, long_entry_price * (1 + tp2_pct / 100), color=color.lime, style=line.style_dotted, extend=extend.right)
    line_tp3_long   := line.new(bar_index-50, long_entry_price * (1 + tp3_pct / 100), bar_index+10, long_entry_price * (1 + tp3_pct / 100), color=color.teal, style=line.style_dotted, extend=extend.right)
    line_trail_long := line.new(bar_index-50, long_trailing_sl, bar_index+10, long_trailing_sl, color=color.orange, width=2, extend=extend.right)

if show_levels and strategy.position_size < 0
    line.delete(line_tp1_short)
    line.delete(line_tp2_short)
    line.delete(line_tp3_short)
    line.delete(line_trail_short)
    line_tp1_short  := line.new(bar_index-50, short_entry_price * (1 - tp1_pct / 100), bar_index+10, short_entry_price * (1 - tp1_pct / 100), color=color.red, style=line.style_dotted, extend=extend.right)
    line_tp2_short  := line.new(bar_index-50, short_entry_price * (1 - tp2_pct / 100), bar_index+10, short_entry_price * (1 - tp2_pct / 100), color=color.maroon, style=line.style_dotted, extend=extend.right)
    line_tp3_short  := line.new(bar_index-50, short_entry_price * (1 - tp3_pct / 100), bar_index+10, short_entry_price * (1 - tp3_pct / 100), color=color.purple, style=line.style_dotted, extend=extend.right)
    line_trail_short:= line.new(bar_index-50, short_trailing_sl, bar_index+10, short_trailing_sl, color=color.orange, width=2, extend=extend.right)


// -----------------------------------------------------------------------------
//                                 DASHBOARD
// -----------------------------------------------------------------------------

var int totalTrades = 0, var int winningTrades = 0, var int losingTrades = 0
var int currentStreak = 0, var bool lastTradeWon = na

if useAsStrategy and inDateRange and strategy.closedtrades > strategy.closedtrades[1]
    float lastClosedProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastClosedProfit > 0
        winningTrades += 1
        currentStreak := not na(lastTradeWon) and lastTradeWon ? currentStreak + 1 : 1
        lastTradeWon := true
    else if lastClosedProfit < 0
        losingTrades += 1
        currentStreak := not na(lastTradeWon) and not lastTradeWon ? currentStreak + 1 : 1
        lastTradeWon := false
    totalTrades := winningTrades + losingTrades

float winRate = totalTrades > 0 ? (winningTrades / totalTrades) * 100 : 0.0

string marketPhase = avgBullishStrength > 0 ? "Bullish Phase (Avg Str: " + str.tostring(avgBullishStrength, "#.#") + ")" : avgBearishStrength > 0 ? "Bearish Phase (Avg Str: " + str.tostring(avgBearishStrength, "#.#") + ")" : isUptrend ? "Uptrend (Price > MA)" : isDowntrend ? "Downtrend (Price < MA)" : "Neutral / Indecision"
if avgBullishStrength > 0 and avgBearishStrength > 0
    marketPhase := "Conflicting Signals / Indecision"

var table dashTable = table.new(position.top_right, 1, 1, border_width=1)
if showDashboard and barstate.islast
    // MODIFICATION: Added strings for exit info and active pattern
    string lastLongEntryStr = na(lastLongEntryPrice) ? "N/A" : str.tostring(lastLongEntryPrice, format.mintick) + " @ " + str.format("{0,date,dd MMM yyyy HH:mm}", lastLongEntryTime)
    string lastShortEntryStr = na(lastShortEntryPrice) ? "N/A" : str.tostring(lastShortEntryPrice, format.mintick) + " @ " + str.format("{0,date,dd MMM yyyy HH:mm}", lastShortEntryTime)
    string lastLongExitStr = na(lastLongExitPrice) ? "N/A" : str.tostring(lastLongExitPrice, format.mintick) + " @ " + str.format("{0,date,dd MMM yyyy HH:mm}", lastLongExitTime)
    string lastShortExitStr = na(lastShortExitPrice) ? "N/A" : str.tostring(lastShortExitPrice, format.mintick) + " @ " + str.format("{0,date,dd MMM yyyy HH:mm}", lastShortExitTime)

    string volConfText = enableVolumeConfirmation ? "\nVolume Confirmation: " + (isVolumeSpike ? "✔ Spike" : "✖ No Spike") : ""
    string srConfText = enableSRConfirmation ? "\nS/R Confirmation: " + (isNearSupport ? "✔ Near Support" : (isNearResistance ? "✔ Near Resistance" : "✖ None")) : ""
    string atrFilterText = enableATRFilter ? "\nATR Filter: Enabled (L:" + str.tostring(longBodyAtrMult) + ", S:" + str.tostring(smallBodyAtrMult) + ")" : ""
    string advConfText = enableAdvancedFollowThrough ? "\nFollow-Through: " + (isFollowThroughBullish or isFollowThroughBearish ? "✔ Confirmed" : "✖ No") : ""
    string mtfFilterText = enableMTFFilter ? "\nHigher TF Trend: " + (isHTFUptrend ? "✔ Uptrend" : (isHTFDowntrend ? "✔ Downtrend" : "✖ Sideways")) : ""

    string activePatternText = "None"
    if avgBullishStrength > avgBearishStrength and avgBullishStrength > 0 and recentBullPattern != ""
        activePatternText := "BULLISH: " + recentBullPattern + " (Str: " + str.tostring(recentBullStrength, "#.#") + ", Bars: " + str.tostring(recentBullDuration) + ")"
    else if avgBearishStrength > avgBullishStrength and avgBearishStrength > 0 and recentBearPattern != ""
        activePatternText := "BEARISH: " + recentBearPattern + " (Str: " + str.tostring(recentBearStrength, "#.#") + ", Bars: " + str.tostring(recentBearDuration) + ")"
    else if avgNeutralStrength > 0 and recentNeutralPattern != ""
        activePatternText := "NEUTRAL: " + recentNeutralPattern + " (Str: " + str.tostring(recentNeutralStrength, "#.#") + ", Bars: " + str.tostring(recentNeutralDuration) + ")"

    // MODIFICATION: Updated dashboard text string
    string dashboardText = "Grand Master's Dominance (ATR)\n" +
       "-------------------------------------------\n" +
       "**Current Market Phase:** " + marketPhase + "\n" +
       "**Active Pattern:** " + activePatternText + "\n" +
       "**Trend:** " + (isUptrend ? "Uptrend" : (isDowntrend ? "Downtrend" : "Sideways")) + "\n" +
       "-------------------------------------------\n" +
       "Avg Bullish Strength: " + str.tostring(avgBullishStrength, "#.##") + " (Count: " + str.tostring(bullishCount) + ")\n" +
       "Avg Bearish Strength: " + str.tostring(avgBearishStrength, "#.##") + " (Count: " + str.tostring(bearishCount) + ")\n" +
       "Avg Neutral Strength: " + str.tostring(avgNeutralStrength, "#.##") + " (Count: " + str.tostring(neutralCount) + ")\n" +
       "-------------------------------------------\n" +
       "**Active Filters**\n" +
       "Min Avg Strength: " + str.tostring(minAvgStrength, "#.#") + "\n" +
       "Min Individual Strength: " + str.tostring(minPatternStrength, "#.#") + "\n" +
       "Trend MA Length: " + str.tostring(maLength) +
       volConfText + srConfText + atrFilterText + advConfText + mtfFilterText +
       "\n-------------------------------------------\n" +
       "**Backtest Stats**\n" +
       "Total Trades: " + str.tostring(totalTrades) + "\n" +
       "Win Rate: " + str.tostring(winRate, "#.##") + "%" + "\n" +
       "Current Streak: " + str.tostring(currentStreak) + (na(lastTradeWon) ? "" : (lastTradeWon ? " (Win)" : " (Loss)")) + "\n" +
       "-------------------------------------------\n" +
       "**Last Trade Info**\n" +
       "Last Long Entry: " + lastLongEntryStr + "\n" +
       "Last Long Exit: " + lastLongExitStr + "\n" +
       "Last Short Entry: " + lastShortEntryStr + "\n" +
       "Last Short Exit: " + lastShortExitStr + "\n" +
       "-------------------------------------------\n" +
       "Mode: " + (useAsStrategy ? "Strategy" : "Indicator") + " | Date Range: " + str.tostring(inDateRange)

    table.cell(dashTable, 0, 0, text=dashboardText, text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)


// Add these 15 alertcondition() lines at the end of your script, before the plot statements or at the end of the logic section.
// -----------------------------------------------------------------------------
// ALERTS (Only valid ones)
// -----------------------------------------------------------------------------
if inDateRange
    if longCondition and enableLongEntryAlert
        alert("LONG ENTRY | Strength: " + str.tostring(avgBullishStrength, "#.#") + " | Pattern: " + recentBullPattern, alert.freq_once_per_bar_close)
    if shortCondition and enableShortEntryAlert
        alert("SHORT ENTRY | Strength: " + str.tostring(avgBearishStrength, "#.#") + " | Pattern: " + recentBearPattern, alert.freq_once_per_bar_close)
    if avgBullishStrength >= minAvgStrength and bullishCount >= 2 and enableStrongBullishAlert
        alert("STRONG BULLISH PATTERN | " + recentBullPattern, alert.freq_once_per_bar_close)
    if avgBearishStrength >= minAvgStrength and bearishCount >= 2 and enableStrongBearishAlert
        alert("STRONG BEARISH PATTERN | " + recentBearPattern, alert.freq_once_per_bar_close)


// -----------------------------------------------------------------------------
//                          ALERTS USING alert() FUNCTION (Toggleable)
// These will trigger alerts when conditions are true and the respective alert is enabled.
// Set up one alert with "Any alert() function call" in the dialog.
// -----------------------------------------------------------------------------

     // 3. Long Exit (Opposite Short Signal While in Long Position)
    if shortCondition and strategy.position_size > 0 and enableLongExitAlert
        alert("Grand Master's Candlestick Dominance: EXIT LONG SIGNAL!\n" +
              "Reason: Bearish reversal pattern detected\n" +
              "Bearish Strength: " + str.tostring(avgBearishStrength, "#.#") + 
              " | Top Pattern: " + recentBearPattern + 
              "\nPrice: " + str.tostring(close, format.mintick), 
              alert.freq_once_per_bar_close)

    // 4. Short Exit (Opposite Long Signal While in Short Position)
    if longCondition and strategy.position_size < 0 and enableShortExitAlert
        alert("Grand Master's Candlestick Dominance: EXIT SHORT SIGNAL!\n" +
              "Reason: Bullish reversal pattern detected\n" +
              "Bullish Strength: " + str.tostring(avgBullishStrength, "#.#") + 
              " | Top Pattern: " + recentBullPattern + 
              "\nPrice: " + str.tostring(close, format.mintick), 
              alert.freq_once_per_bar_close)
    // 5. Strong Bullish Pattern
    if avgBullishStrength >= minAvgStrength and bullishCount >= 2 and enableStrongBullishAlert
        alert("Grand Master's Candlestick Dominance: STRONG BULLISH PATTERN!\nStrength: " + str.tostring(avgBullishStrength, "#.#") + " | Top Pattern: " + recentBullPattern + " | Trend: " + (isUptrend ? "Uptrend" : "Sideways/Down"), alert.freq_once_per_bar_close)

    // 6. Strong Bearish Pattern
    if avgBearishStrength >= minAvgStrength and bearishCount >= 2 and enableStrongBearishAlert
        alert("Grand Master's Candlestick Dominance: STRONG BEARISH PATTERN!\nStrength: " + str.tostring(avgBearishStrength, "#.#") + " | Top Pattern: " + recentBearPattern + " | Trend: " + (isDowntrend ? "Downtrend" : "Sideways/Up"), alert.freq_once_per_bar_close)

    // 7. Neutral/Indecision
    if avgNeutralStrength >= minAvgStrength and neutralCount >= 1 and enableNeutralIndecisionAlert
        alert("Grand Master's Candlestick Dominance: NEUTRAL / INDECISION\nStrength: " + str.tostring(avgNeutralStrength, "#.#") + " | Pattern: " + recentNeutralPattern + " | Volume Spike: " + (isVolumeSpike ? "Yes" : "No"), alert.freq_once_per_bar_close)

    // 8. Volume Spike with Strong Pattern
    if isVolumeSpike and (avgBullishStrength >= minAvgStrength or avgBearishStrength >= minAvgStrength) and enableVolumeSpikeAlert
        alert("Grand Master's Candlestick Dominance: VOLUME SPIKE + STRONG PATTERN!\nBull Str: " + str.tostring(avgBullishStrength, "#.#") + " | Bear Str: " + str.tostring(avgBearishStrength, "#.#") + " | Volume: " + str.tostring(volume) + " | Price: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

    // 9. S/R Breakout
    if enableSRConfirmation and enableSRBreakoutAlert
        bool bullishBreak = not na(ph[1]) and close > ph[1] * (1 + srTolerancePerc) and avgBullishStrength >= minPatternStrength
        bool bearishBreak = not na(pl[1]) and close < pl[1] * (1 - srTolerancePerc) and avgBearishStrength >= minPatternStrength
        if bullishBreak or bearishBreak
            string direction = bullishBreak ? "RESISTANCE BREAKOUT (Bullish)" : "SUPPORT BREAKDOWN (Bearish)"
            alert("Grand Master's Candlestick Dominance: S/R BREAKOUT!\n" + direction + "\nPrice: " + str.tostring(close, format.mintick) + "\nBull Str: " + str.tostring(avgBullishStrength, "#.#") + " | Bear Str: " + str.tostring(avgBearishStrength, "#.#"), alert.freq_once_per_bar_close)

    // 10. Higher Timeframe Trend Reversal
    if enableMTFFilter and (ta.crossover(close, htf_ma) or ta.crossunder(close, htf_ma)) and enableHTFTrendReversalAlert
        string direction = ta.crossover(close, htf_ma) ? "BULLISH" : "BEARISH"
        alert("Grand Master's Candlestick Dominance: HTF TREND REVERSAL (" + direction + ")!\nHTF MA: " + str.tostring(htf_ma, format.mintick) + " | Price: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

    // 11. High-Confidence Single Pattern
    if ((avgBullishStrength >= 8.0 and bullishCount == 1) or (avgBearishStrength >= 8.0 and bearishCount == 1)) and enableHighConfidencePatternAlert
        string pattern = recentBullPattern != "" ? recentBullPattern : recentBearPattern
        float strength = math.max(avgBullishStrength, avgBearishStrength)
        alert("Grand Master's Candlestick Dominance: HIGH-CONFIDENCE PATTERN!\nPattern: " + pattern + " | Strength: " + str.tostring(strength, "#.#") + " | Price: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

    // 12. Conflicting Signals
    if avgBullishStrength >= minAvgStrength and avgBearishStrength >= minAvgStrength and bullishCount > 0 and bearishCount > 0 and enableConflictingSignalsAlert
        alert("Grand Master's Candlestick Dominance: CONFLICTING SIGNALS!\nBull: " + recentBullPattern + " (Str: " + str.tostring(avgBullishStrength, "#.#") + ")\nBear: " + recentBearPattern + " (Str: " + str.tostring(avgBearishStrength, "#.#") + ")\nPrice: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

    // 13. Trend MA Crossover
    if (ta.crossover(close, ma) or ta.crossunder(close, ma)) and enableTrendMACrossoverAlert
        string direction = ta.crossover(close, ma) ? "Bullish" : "Bearish"
        alert("Grand Master's Candlestick Dominance: TREND MA CROSSOVER (" + direction + ")!\nPrice: " + str.tostring(close, format.mintick) + " | MA(" + str.tostring(maLength) + "): " + str.tostring(ma, format.mintick), alert.freq_once_per_bar_close)

    // 14. ATR Volatility Spike
    if enableATRFilter and (bodySize(open, close) > atrValue * longBodyAtrMult * 1.5) and enableATRVolatilitySpikeAlert
        alert("Grand Master's Candlestick Dominance: ATR VOLATILITY SPIKE!\nBody: " + str.tostring(bodySize(open, close), format.mintick) + " | ATR x1.5: " + str.tostring(atrValue * longBodyAtrMult * 1.5, format.mintick) + "\nPrice: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

    // 15. Multi-Bar Pattern Completion
    if ((recentBullPattern != "" and recentBullDuration >= 3 and avgBullishStrength >= minAvgStrength) or (recentBearPattern != "" and recentBearDuration >= 3 and avgBearishStrength >= minAvgStrength)) and enableMultiBarPatternAlert
        string pattern = recentBullPattern != "" ? recentBullPattern : recentBearPattern
        int duration = math.max(recentBullDuration, recentBearDuration)
        float strength = math.max(avgBullishStrength, avgBearishStrength)
        alert("Grand Master's Candlestick Dominance: MULTI-BAR PATTERN COMPLETED!\nPattern: " + pattern + " | Bars: " + str.tostring(duration) + " | Strength: " + str.tostring(strength, "#.#") + "\nPrice: " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// -----------------------------------------------------------------------------
//                                 PLOTS
// -----------------------------------------------------------------------------
// Hidden plots for alert placeholders
plot(avgBullishStrength, title="avgBullishStrength", display=display.none)
plot(avgBearishStrength, title="avgBearishStrength", display=display.none)
plot(avgNeutralStrength, title="avgNeutralStrength", display=display.none)
plot(float(isVolumeSpike ? 1 : 0), title="isVolumeSpike", display=display.none)
plot(float(isUptrend ? 1 : 0), title="isUptrend", display=display.none)
plot(float(isDowntrend ? 1 : 0), title="isDowntrend", display=display.none)
plot(float(isHTFUptrend ? 1 : 0), title="isHTFUptrend", display=display.none)
plot(maLength, title="maLength", display=display.none)
plot(recentBullDuration, title="recentBullDuration", display=display.none)
plot(recentBearDuration, title="recentBearDuration", display=display.none)
plot(bodySize(open, close), title="bodySize", display=display.none)
plot(atrValue, title="atrValue", display=display.none)

plotshape(longCondition, title="Long Entry", location=location.belowbar, color=color.new(color.green, 20), style=shape.triangleup, size=size.small, text="LONG")
plotshape(shortCondition, title="Short Entry", location=location.abovebar, color=color.new(color.red, 20), style=shape.triangledown, size=size.small, text="SHORT")
plot(ma, "Trend MA", color.black, linewidth=2)
plot(enableMTFFilter ? htf_ma : na, "Higher TF MA", color.aqua, linewidth=2, style=plot.style_line)
plot(ph, title="ph", style=plot.style_circles, linewidth=2, color=color.new(color.red, 50), offset=-swingPivotLength)
plot(pl, title="pl", style=plot.style_circles, linewidth=2, color=color.new(color.green, 50), offset=-swingPivotLength)

// -----------------------------------------------------------------------------
// PLOTS
// -----------------------------------------------------------------------------
plotshape(longCondition,  title="Long Entry",  location=location.belowbar, color=color.new(color.green, 20), style=shape.triangleup,   size=size.small, text="LONG")
plotshape(shortCondition, title="Short Entry", location=location.abovebar, color=color.new(color.red, 20),   style=shape.triangledown, size=size.small, text="SHORT")
plot(ma, "Trend MA", color=color.black, linewidth=2)
plot(enableMTFFilter ? htf_ma : na, "Higher TF MA", color=color.aqua, linewidth=2)
plot(ph, style=plot.style_circles, linewidth=2, color=color.new(color.red, 50), offset=-swingPivotLength)
plot(pl, style=plot.style_circles, linewidth=2, color=color.new(color.green, 50), offset=-swingPivotLength)

