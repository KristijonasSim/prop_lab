// prop_lab: fetched from TradingView 2026-10-08
// url: https://www.tradingview.com/script/ubNhdO2q-Grand-Master-s-Candlestick-Dominance-ATR-Enhanced/
// id: PUB;eaffd110bdd349a389d8111cbfef4a19  kind: strategy  likes: 69
//Eternal M a y
//@Eternal_May
// @version=5
strategy("Grand Master's Candlestick Dominance (ATR Enhanced)", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0)

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
// Strategy Settings
useAsStrategy = input.bool(false, "Use as Strategy?", group="Strategy Settings")
showDashboard = input.bool(true, "Show Dashboard?", group="Dashboard Settings")

// Entry/Exit Confirmation Filters
minAvgStrength = input.float(7.0, "Minimum Average Strength for Entry/Exit", minval=1.0, maxval=10.0, step=0.5, group="Confirmation Settings")
minPatternStrength = input.float(5.0, "Minimum Individual Pattern Strength", minval=1.0, maxval=10.0, step=0.5, group="Confirmation Settings")

// Trend Filters
maLength = input.int(20, "Trend MA Length", group="Trend Filters")
enableMTFFilter = input.bool(false, "Enable Higher TF Trend Filter", group="Trend Filters")
higherTimeframe = input.timeframe("D", "Higher Timeframe", group="Trend Filters")
higherTFMALength = input.int(50, "Higher TF MA Length", group="Trend Filters")

// S/R Filter
enableSRConfirmation = input.bool(false, "Enable S/R Confirmation", group="S/R Filters")
swingPivotLength = input.int(10, "S/R Pivot Length", minval=5, group="S/R Filters")
srTolerancePerc = input.float(0.01, "S/R Tolerance %", minval=0.0, maxval=0.1, step=0.001, group="S/R Filters")

// Volume Filter
enableVolumeConfirmation = input.bool(false, "Enable Volume Confirmation", group="Volume Filters")
volumeMALength = input.int(20, "Volume MA Length", group="Volume Filters")
volumeSpikeMultiplier = input.float(1.5, "Volume Spike Multiplier", minval=1.0, group="Volume Filters")

// ATR Filter for Candle Body Size
enableATRFilter = input.bool(true, "Enable ATR Filter for Body Size", group="ATR Filter")
atrLength = input.int(14, "ATR Length", group="ATR Filter")
longBodyAtrMult = input.float(0.8, "Long Body ATR Multiplier (>)", group="ATR Filter", step=0.1)
smallBodyAtrMult = input.float(0.3, "Small Body ATR Multiplier (<)", group="ATR Filter", step=0.1)

// Follow-Through Filter
enableAdvancedFollowThrough = input.bool(false, "Enable Follow-Through Filter", group="Follow-Through Filters")
followThroughType = input.string("Bullish/Bearish Candle", "Follow-Through Type", options=["Bullish/Bearish Candle", "Close Beyond Previous"], group="Follow-Through Filters")

// === TRADE MANAGEMENT & RISK ===
group_tm = "Trade Management & Risk"
use_partial_tp   = input.bool(true, "Enable Partial Take Profits (3 Levels + Runner)", group=group_tm)
tp1_pct          = input.float(10.0, "Take Profit 1 (%)", minval=0.1, group=group_tm)
tp2_pct          = input.float(15.0, "Take Profit 2 (%)", minval=0.1, group=group_tm)
tp3_pct          = input.float(20.0, "Take Profit 3 (%)", minval=0.1, group=group_tm)

tp1_qty_pct      = input.int(25, "TP1 Position %", minval=0, maxval=100, group=group_tm)
tp2_qty_pct      = input.int(25, "TP2 Position %", minval=0, maxval=100, group=group_tm)
tp3_qty_pct      = input.int(25, "TP3 Position %", minval=0, maxval=100, group=group_tm)
runner_qty_pct   = input.int(25, "Runner % (No Fixed TP, Trails Only)", minval=0, maxval=100, group=group_tm)

sl_pct           = input.float(5.0, "Stop Loss / Trail Distance (%)", minval=0.1, group=group_tm)
trail_from_start = input.bool(true, "Trail SL from Highest/Lowest (from bar 1)", group=group_tm, tooltip="If enabled: trail from best price since entry. If disabled: fixed SL until any TP hit.")
show_levels      = input.bool(true, "Show TP/SL/Trailing Lines", group=group_tm)

// Backtest Date Range
startDate = input.time(timestamp("01 Jan 2020 00:00 UTC"), "Start Date", group="Backtest Date Range")
endDate = input.time(timestamp("31 Dec 2025 23:59 UTC"), "End Date", group="Backtest Date Range")
inDateRange = time >= startDate and time <= endDate

// Alert Settings (kept all original)
enableLongEntryAlert = input.bool(true, "Enable Long Entry Alert", group="Alert Settings")
enableShortEntryAlert = input.bool(true, "Enable Short Entry Alert", group="Alert Settings")
enableLongExitAlert = input.bool(true, "Enable Long Exit Alert", group="Alert Settings")
enableShortExitAlert = input.bool(true, "Enable Short Exit Alert", group="Alert Settings")
enableStrongBullishAlert = input.bool(true, "Enable Strong Bullish Pattern Alert", group="Alert Settings")
enableStrongBearishAlert = input.bool(true, "Enable Strong Bearish Pattern Alert", group="Alert Settings")
enableNeutralIndecisionAlert = input.bool(true, "Enable Neutral/Indecision Alert", group="Alert Settings")
enableVolumeSpikeAlert = input.bool(true, "Enable Volume Spike with Strong Pattern Alert", group="Alert Settings")
enableSRBreakoutAlert = input.bool(true, "Enable S/R Breakout Alert", group="Alert Settings")
enableHTFTrendReversalAlert = input.bool(true, "Enable Higher TF Trend Reversal Alert", group="Alert Settings")
enableHighConfidencePatternAlert = input.bool(true, "Enable High-Confidence Single Pattern Alert", group="Alert Settings")
enableConflictingSignalsAlert = input.bool(true, "Enable Conflicting Signals Alert", group="Alert Settings")
enableTrendMACrossoverAlert = input.bool(true, "Enable Trend MA Crossover Alert", group="Alert Settings")
enableATRVolatilitySpikeAlert = input.bool(true, "Enable ATR Volatility Spike Alert", group="Alert Settings")
enableMultiBarPatternAlert = input.bool(true, "Enable Multi-Bar Pattern Completion Alert", group="Alert Settings")

// -----------------------------------------------------------------------------
// CALCULATIONS & PATTERNS (All original patterns and arrays unchanged)
// -----------------------------------------------------------------------------
float atrValue = ta.atr(atrLength)

// [All helper functions, patterns, arrays, fillPatternArrays() remain exactly as in your original code]
// -----------------------------------------------------------------------------
// ENHANCED HELPER FUNCTIONS
// -----------------------------------------------------------------------------
isBullish(o, c) => c > o
isBearish(o, c) => c < o

bodySize(o, c) => math.abs(c - o)
candleRange(h, l) => h - l

upperShadow(o, c, h) => h - math.max(o, c)
lowerShadow(o, c, l) => math.min(o, c) - l

// Common ratios
bodyToRangeRatio(o, c, h, l) => bodySize(o, c) / candleRange(h, l)
upperToBodyRatio(o, c, h) => upperShadow(o, c, h) / bodySize(o, c)
lowerToBodyRatio(o, c, l) => lowerShadow(o, c, l) / bodySize(o, c)

// ATR-aware body size (with fallback)
isSmallBody(o, c, h, l, atr, mult, fallbackPerc = 0.25) => 
     enableATRFilter ? bodySize(o, c) < atr * mult : bodySize(o, c) < candleRange(h, l) * fallbackPerc

isLongBody(o, c, h, l, atr, mult, fallbackPerc = 0.60) => 
     enableATRFilter ? bodySize(o, c) > atr * mult : bodySize(o, c) > candleRange(h, l) * fallbackPerc

// Doji with configurable tolerance
isDojiCandle(o, c, h, l, atr, mult, tolerancePerc = 0.1) => 
     isSmallBody(o, c, h, l, atr, mult, tolerancePerc) and 
     (upperShadow(o, c, h) > 0 or lowerShadow(o, c, l) > 0)

// Gaps
isGapUp(currentOpen, prevHigh)  => currentOpen > prevHigh
isGapDown(currentOpen, prevLow) => currentOpen < prevLow

// Strict Harami (current fully inside previous range)
isHaramiStrict(o, c, h, l, o1, c1, h1, l1) => h < h1 and l > l1

// Engulfing (body engulfing + opposite direction)
isEngulfing(o, c, o1, c1) => 
     bodySize(o, c) > bodySize(o1, c1) and isBullish(o, c) != isBullish(o1, c1)

// Marubozu (near-perfect body, minimal shadows)
isMarubozu(o, c, h, l, tolerancePerc = 0.05) => 
     bodySize(o, c) >= candleRange(h, l) * (1 - tolerancePerc)

// Long shadow helpers
isLongUpperShadow(o, c, h, ratio = 2.0) => upperShadow(o, c, h) >= bodySize(o, c) * ratio
isLongLowerShadow(o, c, l, ratio = 2.0) => lowerShadow(o, c, l) >= bodySize(o, c) * ratio
isLongShadowPercent(shadow, p_range, perc) => shadow > p_range * perc  // ← This must be here
// -----------------------------------------------------------------------------
//                           BULLISH PATTERNS+. 
// -----------------------------------------------------------------------------
// 1. Hammer (Strength 8.0)
bool isHammer = isBearish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult, 0.2) and lowerShadow(open, close, low) > 2 * bodySize(open, close) and upperShadow(open, close, high) < 0.1 * candleRange(high, low)
float hammerStrength = 8.0

// 2. Bullish Engulfing (Strength 10.0)
bool isBullishEngulfing = isBearish(open[1], close[1]) and isBullish(open, close) and isEngulfing(open, close, open[1], close[1])
float bullishEngulfingStrength = 10.0

// 3. Piercing Line (Strength 8.0)
bool isPiercingLine = isBearish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBullish(open, close) and open < low[1] and close > (open[1] + close[1]) / 2 and close < open[1]
float piercingLineStrength = 8.0

// 4. Morning Star (Strength 7.0)
bool isMorningStar = isBearish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and open[1] < close[2] and isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and close > (open[2] + close[2]) / 2
float morningStarStrength = 7.0

// 5. Three White Soldiers (Strength 9.0)
bool is3WhiteSoldiers = isBullish(open[2], close[2]) and isBullish(open[1], close[1]) and isBullish(open, close) and close[1] > close[2] and close > close[1] and open > open[2] and open[1] > open[2] and open < close[1]
float threeWhiteSoldiersStrength = 9.0

// 6. Inverted Hammer (Strength 6.0)
bool isInvertedHammer = isBearish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult, 0.2) and upperShadow(open, close, high) > 2 * bodySize(open, close) and lowerShadow(open, close, low) < 0.1 * candleRange(high, low)
float invertedHammerStrength = 6.0

// 7. Bullish Harami (Strength 6.0)
bool isHaramiBull = isBearish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBullish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult, 0.25) and isHaramiStrict(open, close, high, low, open[1], close[1], high[1], low[1])
float haramiBullStrength = 6.0

// 8. Rising Three (Strength 8.0)
bool isRisingThree = isBullish(open[4], close[4]) and isLongBody(open[4], close[4], high[4], low[4], atrValue[4], longBodyAtrMult) and isBearish(open[3], close[3]) and isBearish(open[2], close[2]) and isBearish(open[1], close[1]) and close[1] > open[4] and isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and close > high[4]
float risingThreeStrength = 8.0

// 9. Tweezer Bottom (Strength 6.0)
bool isTweezersBottom = low[1] == low and isBearish(open[1], close[1]) and isBullish(open, close)
float tweezersBottomStrength = 6.0

// 10. Bullish Marubozu (Strength 8.0)
bool isMarubozuBull = isMarubozu(open, close, high, low) and isBullish(open, close)
float marubozuBullStrength = 8.0

// 11. Bullish Belt Hold (Strength 6.0)
bool isBeltHoldBull = isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and open == low
float beltHoldBullStrength = 6.0

// 12. Matching Low (Strength 4.0)
bool isMatchingLow = isBearish(open[1], close[1]) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and isBearish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult) and close == close[1] and low == low[1]
float matchingLowStrength = 4.0

// 13. Three Inside Up (Strength 7.0)
bool is3InsideBull = isBearish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isHaramiBull[1] and isBullish(open, close) and close > close[2]
float threeInsideBullStrength = 7.0

// 14. Bullish Kicking (Strength 10.0)
bool isKickingBull = isMarubozu(open[1], close[1], high[1], low[1]) and isBearish(open[1], close[1]) and isMarubozuBull and isGapUp(open, high[1])
float kickingBullStrength = 10.0

// 15. Stick Sandwich (Strength 6.0)
bool isStickSandwich = isBearish(open[2], close[2]) and isBearish(open[1], close[1]) and isBullish(open, close) and close == close[2] and close < close[1]
float stickSandwichStrength = 6.0

// 16. Ladder Bottom (Strength 7.0)
bool isLadderBottom = isBearish(open[4], close[4]) and isBearish(open[3], close[3]) and isBearish(open[2], close[2]) and isBearish(open[1], close[1]) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and open[1] < close[2] and isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult)
float ladderBottomStrength = 7.0

// 17. Dragonfly Doji (Strength 8.0)
bool isDragonflyDoji = isDojiCandle(open, close, high, low, atrValue, smallBodyAtrMult) and lowerShadow(open, close, low) > bodySize(open, close) * 5 and upperShadow(open, close, high) < bodySize(open, close) * 0.1
float dragonflyDojiStrength = 8.0

// 18. White Marubozu (Strength 8.0)
float whiteMarubozuStrength = 8.0 // Same as Bullish Marubozu

// 19. Three Line Strike (Bullish) (Strength 9.0)
bool is3LineStrikeBull = isBearish(open[3], close[3]) and isBearish(open[2], close[2]) and isBearish(open[1], close[1]) and close[1] < close[2] and close[2] < close[3] and isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and close > open[3]
float threeLineStrikeBullStrength = 9.0

// 20. Abandoned Baby (Bullish) (Strength 10.0)
bool isAbandonedBabyBull = isBearish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isDojiCandle(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult)[1] and low[1] < low[2] and high[1] < close[2] and isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and open > high[1] and open > close[2]
float abandonedBabyBullStrength = 10.0

// 21. Thrusting Line (Strength 4.0)
bool isThrustingLine = isBearish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBullish(open, close) and open < close[1] and close > close[1] and close < (open[1] + close[1]) / 2
float thrustingLineStrength = 4.0

// 22. Meeting Lines (Bullish) (Strength 4.0)
bool isMeetingLinesBull = isBearish(open[1], close[1]) and isBullish(open, close) and math.abs(close - close[1]) / syminfo.mintick < 2
float meetingLinesBullStrength = 4.0

// 23. Separating Lines (Bullish) (Strength 6.0)
bool isSeparatingLinesBull = isBullish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBullish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and open == open[1] and open > close[1]
float separatingLinesBullStrength = 6.0

// 24. Unique Three River Bottom (Strength 8.0)
bool isUnique3RiverBottom = isBearish(open[2], close[2]) and isBearish(open[1], close[1]) and low[1] < low[2] and isBullish(open, close) and open > low[1] and open < close[1] and close < open[1] and low == low[1]
float unique3RiverBottomStrength = 8.0

// 25. Hook Reversal (Bullish) (Strength 6.0)
bool isHookReversalBull = isBullish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBullish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult) and open > close[1] and open < open[1] and close > high[1]
float hookReversalBullStrength = 6.0

// -----------------------------------------------------------------------------
//                             BEARISH PATTERNS
// -----------------------------------------------------------------------------
// 26. Hanging Man (Strength 8.0)
bool isHangingMan = isBullish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult, 0.2) and lowerShadow(open, close, low) > 2 * bodySize(open, close) and upperShadow(open, close, high) < 0.1 * candleRange(high, low)
float hangingManStrength = 8.0

// 27. Bearish Engulfing (Strength 10.0)
bool isBearishEngulfing = isBullish(open[1], close[1]) and isBearish(open, close) and isEngulfing(open, close, open[1], close[1])
float bearishEngulfingStrength = 10.0

// 28. Dark Cloud Cover (Strength 8.0)
bool isDarkCloudCover = isBullish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBearish(open, close) and open > high[1] and close < (open[1] + close[1]) / 2 and close > open[1]
float darkCloudCoverStrength = 8.0

// 29. Evening Star (Strength 7.0)
bool isEveningStar = isBullish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and open[1] > close[2] and isBearish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and close < (open[2] + close[2]) / 2
float eveningStarStrength = 7.0

// 30. Three Black Crows (Strength 9.0)
bool is3BlackCrows = isBearish(open[2], close[2]) and isBearish(open[1], close[1]) and isBearish(open, close) and close[1] < close[2] and close < close[1] and open < open[2] and open[1] < open[2] and open > close[1]
float threeBlackCrowsStrength = 9.0

// 31. Gravestone Doji (Strength 8.0)
bool isGravestoneDoji = isDojiCandle(open, close, high, low, atrValue, smallBodyAtrMult) and upperShadow(open, close, high) > bodySize(open, close) * 5 and lowerShadow(open, close, low) < bodySize(open, close) * 0.1
float gravestoneDojiStrength = 8.0

// 32. Shooting Star (Strength 6.0)
bool isShootingStar = isBullish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult, 0.2) and upperShadow(open, close, high) > 2 * bodySize(open, close) and lowerShadow(open, close, low) < 0.1 * candleRange(high, low)
float shootingStarStrength = 6.0

// 33. Bearish Harami (Strength 6.0)
bool isHaramiBear = isBullish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and isBearish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult, 0.25) and isHaramiStrict(open, close, high, low, open[1], close[1], high[1], low[1])
float haramiBearStrength = 6.0

// 34. Falling Three (Strength 8.0)
bool isFallingThree = isBearish(open[4], close[4]) and isLongBody(open[4], close[4], high[4], low[4], atrValue[4], longBodyAtrMult) and isBullish(open[3], close[3]) and isBullish(open[2], close[2]) and isBullish(open[1], close[1]) and close[1] < open[4] and isBearish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and close < low[4]
float fallingThreeStrength = 8.0

// 35. Tweezer Top (Strength 6.0)
bool isTweezersTop = high[1] == high and isBullish(open[1], close[1]) and isBearish(open, close)
float tweezersTopStrength = 6.0

// 36. Bearish Marubozu (Strength 8.0)
bool isMarubozuBear = isMarubozu(open, close, high, low) and isBearish(open, close)
float marubozuBearStrength = 8.0

// 37. Bearish Belt Hold (Strength 6.0)
bool isBeltHoldBear = isBearish(open, close) and isLongBody(open, close, high, low, atrValue, longBodyAtrMult) and open == high
float beltHoldBearStrength = 6.0

// 38. Matching High (Strength 4.0)
bool isMatchingHigh = isBullish(open[1], close[1]) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and isBullish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult) and close == close[1] and high == high[1]
float matchingHighStrength = 4.0

// 39. Three Inside Down (Strength 7.0)
bool is3InsideBear = isBullish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isHaramiBear[1] and isBearish(open, close) and close < close[2]
float threeInsideBearStrength = 7.0

// 40. Bearish Kicking (Strength 10.0)
bool isKickingBear = isMarubozu(open[1], close[1], high[1], low[1]) and isBullish(open[1], close[1]) and isMarubozuBear and isGapDown(open, low[1])
float kickingBearStrength = 10.0

// 41. Deliberation (Strength 4.0)
bool isDeliberation = isBullish(open[2], close[2]) and isBullish(open[1], close[1]) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and open > open[2] and close > close[2] and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult) and open > open[1] and close > close[1]
float deliberationStrength = 4.0

// 42. Descending Hawk (Strength 4.0)
bool isDescendingHawk = isBullish(open[1], close[1]) and isBearish(open, close) and high == high[1] and low < low[1]
float descendingHawkStrength = 4.0

// 43. Downside Tasuki Gap (Strength 6.0)
bool isDownsideTasukiGap = isBearish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isBearish(open[1], close[1]) and isLongBody(open[1], close[1], high[1], low[1], atrValue[1], longBodyAtrMult) and open[1] < close[2] and isBullish(open, close) and isSmallBody(open, close, high, low, atrValue, smallBodyAtrMult) and open > close[1] and open < open[1] and close > open[1] and close < close[2]
float downsideTasukiGapStrength = 6.0

// 44. Upside Gap Two Crows (Strength 8.0)
bool isUpsideGapTwoCrows = isBullish(open[2], close[2]) and isLongBody(open[2], close[2], high[2], low[2], atrValue[2], longBodyAtrMult) and isBearish(open[1], close[1]) and isSmallBody(open[1], close[1], high[1], low[1], atrValue[1], smallBodyAtrMult) and open[1] > high[2] and isBearish(open, close) and close < open[1] and open < close[2]
float upsideGapTwoCrowsStrength = 8.0

// 45. Black Marubozu (Strength 8.0)
float blackMarubozuStrength = 8.0 // Same as Bearish Marubozu

// 46. Dark Cloud Cover (Weakened) (Strength 6.0)
