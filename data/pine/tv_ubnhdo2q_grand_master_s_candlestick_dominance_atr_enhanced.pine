    array.set(bearishPatternResults, 2, isDarkCloudCover)
    array.set(bearishPatternResults, 3, isEveningStar)
    array.set(bearishPatternResults, 4, is3BlackCrows)
    array.set(bearishPatternResults, 5, isGravestoneDoji)
    array.set(bearishPatternResults, 6, isShootingStar)
