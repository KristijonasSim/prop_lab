fillPatternArrays() =>
    array.set(bullishPatternResults, 0, isHammer)
    array.set(bullishPatternResults, 1, isBullishEngulfing)
    array.set(bullishPatternResults, 2, isPiercingLine)
    array.set(bullishPatternResults, 3, isMorningStar)
    array.set(bullishPatternResults, 4, is3WhiteSoldiers)
    array.set(bullishPatternResults, 5, isInvertedHammer)
    array.set(bullishPatternResults, 6, isHaramiBull)
    array.set(bullishPatternResults, 7, isRisingThree)
    array.set(bullishPatternResults, 8, isTweezersBottom)
    array.set(bullishPatternResults, 9, isMarubozuBull)
    array.set(bullishPatternResults, 10, isBeltHoldBull)
    array.set(bullishPatternResults, 11, isMatchingLow)
    array.set(bullishPatternResults, 12, is3InsideBull)
    array.set(bullishPatternResults, 13, isKickingBull)
    array.set(bullishPatternResults, 14, isStickSandwich)
    array.set(bullishPatternResults, 15, isLadderBottom)
    array.set(bullishPatternResults, 16, isDragonflyDoji)
    array.set(bullishPatternResults, 17, isMarubozuBull) // White Marubozu
    array.set(bullishPatternResults, 18, is3LineStrikeBull)
    array.set(bullishPatternResults, 19, isAbandonedBabyBull)
    array.set(bullishPatternResults, 20, isThrustingLine)
    array.set(bullishPatternResults, 21, isMeetingLinesBull)
    array.set(bullishPatternResults, 22, isSeparatingLinesBull)
    array.set(bullishPatternResults, 23, isUnique3RiverBottom)
    array.set(bullishPatternResults, 24, isHookReversalBull)
    array.set(bearishPatternResults, 0, isHangingMan)
