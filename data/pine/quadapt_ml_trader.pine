//@version=6
indicator(title="[Quadapt] Machine Learning Trader", shorttitle="[Quadapt] ML Trader", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=2000)

// NOTE (prop_lab): pasted by Kris 2026-09-24. Trimmed to the parts that decide
// a trade - signal logic, filters, stop and targets. Drawing, tables, labels,
// webhooks, order-block visuals and alerts are removed; nothing that changes
// WHEN or WHICH WAY it enters was cut.

//---------------------------------------------------------------------------------------------------------------------
// Dual Length Trading Signal Settings
//---------------------------------------------------------------------------------------------------------------------
len1 = input.int(120, title="Primary Length", minval=1)
len2 = input.int(70, title="Secondary Length", minval=1)
enable_dual_length = input.bool(true, title="Enable Dual Length Analysis")
signal_consensus = input.string("Independent", title="Signal Mode", options=["Independent", "Consensus", "Primary Priority"])

//---------------------------------------------------------------------------------------------------------------------
// TP / SL settings
//---------------------------------------------------------------------------------------------------------------------
fib_method = input.string('Swing-Based', title="TP Calculation Method", options=['Dynamic ATR', 'Swing-Based', 'Adaptive Swing', 'Heuristic'])
fib_lookback = input.int(50, title="Swing Lookback Period", minval=10, maxval=200)
fib_atr_period = input.int(20, title="ATR Period", minval=5, maxval=100)
max_tp_levels = input.int(4, title="Max TP Levels", minval=2, maxval=6)
tp_spacing_multiplier = input.float(1.5, title="TP Spacing Multiplier", minval=1.0, maxval=3.0, step=0.1)
signal_validation_tolerance = input.float(3.5, title="Signal Validation Tolerance (ATR)")
sl_method = input.string("Swing-based", title="SL Method", options=["ATR-based", "Swing-based", "Order Block", "Percentage"])
sl_atr_multiplier = input.float(2.0, title="SL ATR Multiplier")
sl_swing_buffer = input.float(0.5, title="Swing SL Buffer (ATR)")

// MTF trend table timeframes (used by the quality score)
trend_table_tf_1 = input.timeframe("15")
trend_table_tf_2 = input.timeframe("30")
trend_table_tf_3 = input.timeframe("60")

//---------------------------------------------------------------------------------------------------------------------
// Regression (MLMA) settings
//---------------------------------------------------------------------------------------------------------------------
window = input.int(200, title = "Window Size")
forecast = input.int(0, title = "Forecast Steps")
mult = input.float(2, 'Multiplicative Factor')
src = input.source(close, 'Source')
regressor_type = input.string("SVR", "Regressor Type", options = ["GPR", "KRR", "KPCR", "SVR", "Kernel Smoothing", "Adaptive RQ"])
mlma_kernel_type = input.string("Periodic", "MLMA Kernel")
periodic_length_scale = input.float(1.0, "Periodic Length Scale")
periodic_period = input.float(1.0, "Period")
C_svr = input.float(1.0, "C Parameter")
epsilon_svr = input.float(0.1, "Epsilon")

// Order block detection
volatilityLength = input.int(6)
smoothLength = input.int(9)
multiplier = input.float(1.2)
momentumPeriod = input.int(20)
consolidationThreshold = input.float(1.2)
obRegimeAtrPeriod = input.int(40)

// Signal quality engine
enable_signal_quality_engine = input.bool(true)
min_trade_quality_score = input.float(50.0)
strict_no_trade_filter = input.bool(true)
loss_streak_penalty = input.float(8.0)

//---------------------------------------------------------------------------------------------------------------------
// Common values
//---------------------------------------------------------------------------------------------------------------------
safe_denominator(value) =>
    math.max(math.abs(nz(value, syminfo.mintick)), syminfo.mintick)

avg_volume = nz(ta.sma(volume, 20), volume)
atr_val = ta.atr(fib_atr_period)
atr_dynamic = safe_denominator(atr_val)
avg_atr = safe_denominator(nz(ta.sma(atr_dynamic, 20), atr_dynamic))
market_regime = ta.change(close, 10) > avg_atr * 0.5 ? 1 : ta.change(close, 10) < -avg_atr * 0.5 ? 1 : 2
rsi_14 = ta.rsi(close, 14)
sma_10 = ta.sma(close, 10)
sma_10_delayed = ta.sma(close[5], 10)
sma_slope = sma_10 - sma_10_delayed
volume_ma = ta.sma(nz(volume), 10)

//---------------------------------------------------------------------------------------------------------------------
// MLMA: kernel regression (SVR, periodic kernel) of the last `window` closes.
// Weights are fixed once on the first bar (depend only on bar positions), then
// mlma = weights . (src[window-1-i] - sma(src, window)) + sma(src, window).
// With period 1.0 the periodic kernel sin(pi*k) is 0 at every integer distance,
// so K is all ones - the regression collapses to (close to) a plain SMA(200).
//---------------------------------------------------------------------------------------------------------------------
periodic_kernel(x1, x2) =>
    d = math.abs(x1 - x2) / window
    s = math.sin(math.pi * d * window / periodic_period)
    math.exp(-(periodic_length_scale * periodic_length_scale / 2) * s * s)

var array<float> w = na
if barstate.isfirst
    n = window
    K = matrix.new<float>(n, n, 0.0)
    for i = 0 to n - 1
        for j = 0 to n - 1
            K.set(i, j, periodic_kernel(i, j))
    I = matrix.new<float>(n, n, 0.0)
    for i = 0 to n - 1
        I.set(i, i, 1.0)
    reg = (1.0 / C_svr) + epsilon_svr
    Kinv = K.sum(I.mult(reg)).pinv()
    w := K.transpose().mult(Kinv).row(window + forecast - 1)

var os = 0
mean = ta.sma(src, window)
float mlma_out = na
if bar_index >= window and not na(w)
    dot = 0.0
    for i = 0 to window - 1
        dot += w.get(i) * (src[window - 1 - i] - mean)
    mlma_out := dot + mean

mae = ta.sma(math.abs(src - mlma_out), window) * mult
mlma_upper = mlma_out + mae
mlma_lower = mlma_out - mae
if close > mlma_upper and mlma_out > mlma_out[1]
    os := 1
else if close < mlma_lower and mlma_out < mlma_out[1]
    os := 0

//---------------------------------------------------------------------------------------------------------------------
// Envelope signal, primary length (len1) - the actual entry trigger
//---------------------------------------------------------------------------------------------------------------------
envelope(len) =>
    ema_c = ta.ema(close, len)
    nb = math.abs(close - ema_c) / safe_denominator(ema_c)
    synth = math.sin(0.68 * nb * nb + 0.79 * nb + nb) * math.cos(0.68 * nb * nb + 0.79 * nb + nb)
    b = math.abs(synth) * safe_denominator(ema_c)
    d = ta.ema(b, len)
    upper = ema_c + d
    lower = ema_c - d
    smooth_hi = ta.ema(math.max(upper, close), len)
    smooth_lo = ta.ema(math.min(close, lower), len)
    rp = math.max(1, int(len / 5))
    wedge = ta.rising(smooth_lo, rp) and ta.falling(smooth_hi, rp)
    falling_range = ta.falling(smooth_hi - smooth_lo, len)
    falling_ended = falling_range[1] and not falling_range
    buy = falling_ended and close > smooth_lo and not wedge
    sell = falling_ended and close < smooth_hi and not wedge
    [buy, sell, wedge, ema_c]

[buy1, sell1, wedge1, ema1] = envelope(len1)
[buy2, sell2, wedge2, ema2] = envelope(len2)

// "Independent" mode: either length may fire
raw_buy = buy1 or (enable_dual_length and buy2)
raw_sell = sell1 or (enable_dual_length and sell2)

//---------------------------------------------------------------------------------------------------------------------
// Quality engine - a signal is only taken if it is not in a no-trade regime and
// its weighted quality score >= 50. The dominant hard filter is trend_conflict:
// a buy needs os == 1 (MLMA trend up), a sell needs os == 0.
//---------------------------------------------------------------------------------------------------------------------
isConsolidating = math.abs(close - close[10]) / safe_denominator(ta.atr(obRegimeAtrPeriod)) < consolidationThreshold
mlma_tf1 = request.security(syminfo.tickerid, trend_table_tf_1, os[1], lookahead=barmerge.lookahead_off)
mlma_tf2 = request.security(syminfo.tickerid, trend_table_tf_2, os[1], lookahead=barmerge.lookahead_off)
mlma_tf3 = request.security(syminfo.tickerid, trend_table_tf_3, os[1], lookahead=barmerge.lookahead_off)

aligned(dir, t) => dir == 1 ? t == 1 : t == 0

no_trade(dir) =>
    cloud_w = math.abs(mlma_upper - mlma_lower) / atr_dynamic
    slope = math.abs(mlma_out - mlma_out[3]) / atr_dynamic
    vr = atr_dynamic / avg_atr
    choppy = isConsolidating or wedge1 or (enable_dual_length and wedge2) or (market_regime == 2 and slope < 0.15)
    compressed = vr < 0.55
    conflict = not aligned(dir, os)
    trapped = cloud_w < 0.8 and close > mlma_lower and close < mlma_upper
    strict_no_trade_filter and (choppy or compressed or conflict or trapped)

quality(dir) =>
    mtf = ((aligned(dir, os) ? 1 : 0) + (aligned(dir, mlma_tf1) ? 1 : 0) + (aligned(dir, mlma_tf2) ? 1 : 0) + (aligned(dir, mlma_tf3) ? 1 : 0)) / 4.0 * 100
    slope_ok = dir == 1 ? mlma_out > mlma_out[1] : mlma_out < mlma_out[1]
    price_ok = dir == 1 ? close > mlma_out : close < mlma_out
    ctx = (aligned(dir, os) ? 35.0 : 0) + (slope_ok ? 25.0 : 0) + (price_ok ? 20.0 : 0) + 15.0
    vr = nz(volume) / safe_denominator(volume_ma)
    vol_s = vr >= 1.5 ? 100.0 : vr >= 1.1 ? 85.0 : vr >= 0.8 ? 60.0 : 35.0
    ar = atr_dynamic / avg_atr
    atr_s = ar < 0.55 ? 25.0 : ar < 0.8 ? 60.0 : ar <= 2.2 ? 90.0 : 55.0
    body = math.abs(close - open) / safe_denominator(high - low)
    rsi_ok = dir == 1 ? rsi_14 > 50 and rsi_14 < 72 : rsi_14 < 50 and rsi_14 > 28
    candle_ok = dir == 1 ? close > open : close < open
    sl_ok = dir == 1 ? sma_slope > 0 : sma_slope < 0
    mom = (rsi_ok ? 35.0 : 10.0) + (candle_ok ? 25.0 : 5.0) + (sl_ok ? 25.0 : 5.0) + (body > 0.45 ? 15.0 : 5.0)
    ctx * 0.27 + mtf * 0.22 + mom * 0.18 + atr_s * 0.13 + vol_s * 0.08 + 50.0 * 0.12

buy_ok = raw_buy and not no_trade(1) and quality(1) >= min_trade_quality_score
sell_ok = raw_sell and not no_trade(-1) and quality(-1) >= min_trade_quality_score

// Entry on the first bar of a new signal, at the close
go_long = buy_ok and not buy_ok[1] and barstate.isconfirmed
go_short = sell_ok and not sell_ok[1] and barstate.isconfirmed

//---------------------------------------------------------------------------------------------------------------------
// Exits: stop = most recent qualifying swing low/high over 50 bars -/+ 0.5 ATR(20)
// (falls back to 2 ATR). Targets = swing distance x 1.272, x1.5x1.414, ... ;
// the trade closes on the stop or when all four targets are hit.
//---------------------------------------------------------------------------------------------------------------------
plotshape(go_long, style=shape.triangleup, location=location.belowbar)
plotshape(go_short, style=shape.triangledown, location=location.abovebar)
