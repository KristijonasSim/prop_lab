// prop_lab: fetched from TradingView 2026-09-30
// url: https://www.tradingview.com/script/DcjBbnzh-Concordance-Regime-Synthesis-JOAT/
// id: PUB;f26356a84c814bf4814cef2c94a04b7a  kind: strategy
