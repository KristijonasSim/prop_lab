//@version=5
strategy("Bollinger Squeeze Breakout", overlay=true)
length = input.int(20)
mult   = input.float(2.0)
basis  = ta.sma(close, length)
dev    = mult * ta.stdev(close, length)
upper  = basis + dev
lower  = basis - dev
bbw    = (upper - lower) / basis
squeeze = bbw < ta.lowest(bbw, 100)
longCondition = squeeze and close > upper
if (longCondition)
    strategy.entry("L", strategy.long)
