# Local environment only — rebuild from requirements-lock.txt
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Secrets
.env

# Everything else is committed on purpose, including data/ and backtests/,
# so a clone reproduces the results without re-downloading anything.
#
# Exception: sweep outputs above ~100 MB as CSV. GitHub hard-rejects those, so
# the large ones are committed as zstd parquet instead (same data, ~7x smaller)
# and the raw CSV is ignored. See strategies/*/build_report.py for the readers.
backtests/vwap/stage1_grid.csv
backtests/vwap/stage2_paper.csv
backtests/vwap/stage3_timeframes.csv

# forward-collected feeds: appended continuously, not a reproducible artefact
data/feeds/*.log

# tick archive for the maker fill check (1.6GB, re-downloadable from
# data.binance.vision via strategies/vwap/stage12_queue.py)
data/ticks/

# bookDepth aggregates (424MB across 11 coins, re-downloadable from
# data.binance.vision via core/binance_depth.py). Same reasoning as data/ticks/:
# fully reproducible from a script that is committed. Reverse this if the
# rebuild time (~4 min/coin) turns out to matter more than the repo size.
data/feeds/*_depth_5m.parquet

# paper-trade signal log: a run artefact, not a result
live/paper/vwapbreak_signals.jsonl

# never commit exchange credentials
*.env
.env*
live/*_keys.json
live/paper/bybit_state.json
live/paper/bybit_cron.log
live/paper/.bybit_cron.lock
